(defclass RESIN-control (windoid)  ((name :initarg :name :initform "  GEL CONTROL" :accessor name :type symbol)   (process :initarg :process :initform *GEL-PROCESS* :accessor process :type process)   (start-time :initarg :start-time :initform 0 :accessor start-time :type number)   (stop-time :initarg :stop-time :initform 0 :accessor stop-time :type number)      )  (:default-initargs    :close-box-p t    :view-size #@(330 250)    :view-font '("Times" 12 :PLAIN)  )  (:documentation   "control windoid for resin process"  ))(defmethod initialize-instance :after ((self RESIN-control) &key)  (let ((name (make-instance 'static-text-dialog-item                       :view-position #@(110 2)                       :view-nick-name 'name                       :dialog-item-text (name self)                       :view-font '("Times" 16 :PLAIN)))        (start-button (make-instance 'button-dialog-item                        :view-position #@(10 25)                        :view-size #@(90 18)                        :view-nick-name 'START                        :dialog-item-text "START GEL"                        :view-font '("Times" 12 :bold)                        :border-p t                        :dialog-item-action #'(lambda (x)                                                (declare (ignore x))                                                (when (not *GEL-PROCESS*)                                                  (setf *GEL-PROCESS* (make-process "gel"))                                                  (process-preset *GEL-PROCESS* #'run-sin)                                                  (process-enable *GEL-PROCESS*)                                                  (setf (start-time self) (get-universal-time)) )                                                  (set-dialog-item-text (view-named 'time self)                                                                        (format nil "00'00\""))                                                  (set-part-color (view-named 'start self) :text *green-color*)                                                  (view-draw-contents self))))        (end-button (make-instance 'button-dialog-item                       :view-position #@(10 47)                       :view-font '("Times" 10 :PLAIN)                       :dialog-item-text "End..."                       :border-p t                       :view-nick-name 'end                       :dialog-item-action #'(lambda (x)                                               (declare (ignore x))                                               (setf *end* t)                                               (set-dialog-item-text (view-named 'comment self)                                                                        "end request sent..."))))        (abort-button (make-instance 'button-dialog-item                        :view-position #@(10 65)                        :view-font '("Times" 10 :PLAIN)                        :dialog-item-text "! abort"                        :border-p t                        :view-nick-name 'abort                        :dialog-item-action #'(lambda (x)                                                (declare (ignore x))                                                (when *GEL-PROCESS*                                                  (process-disable *GEL-PROCESS*)                                                (setf *GEL-PROCESS* nil))                                                (set-part-color (view-named 'start self)                                                                :text *black-color*)                                                (set-dialog-item-text (view-named 'comment self)                                                                        "gel process aborted."))))        (next-button (make-instance 'button-dialog-item                        :view-position #@(250 25)                        :view-size #@(70 15)                        :view-font '("Times" 10 :PLAIN)                        :dialog-item-text "next step"                        :border-p t                        :view-nick-name 'next                        :dialog-item-action #'(lambda (x)                                                (declare (ignore x))                                                (setf *GO* t)                                                )))                (time (make-instance 'static-text-dialog-item                       :view-position #@(150 45)                       :view-nick-name 'time                       :dialog-item-text "00'00\""                       :view-font '("Times" 24 :BOLD)))        (freq1 (make-instance 'static-text-dialog-item                       :view-position #@(100 100)                       :view-nick-name 'freq1                       :dialog-item-text "0.0000"                       :view-font '("Times" 24 :BOLD)))        (freq2 (make-instance 'static-text-dialog-item                       :view-position #@(180 100)                       :view-nick-name 'freq2                       :dialog-item-text "0.0000"                       :view-font '("Times" 24 :BOLD)))        (comment (make-instance 'static-text-dialog-item                       :view-position #@(100 140)                       :view-size #@(200 30)                       :view-nick-name 'comment                       :dialog-item-text "       Ready !"                       :view-font '("Times" 16 :plain)))        (ttitre (make-instance 'static-text-dialog-item                       :view-position #@(60 190)                       :dialog-item-text "time fact"                       :view-font '("Times" 12 :plain)))        (timefact (make-instance 'static-text-dialog-item                       :view-position #@(60 208)                       :view-nick-name 'timefact                       :dialog-item-text (format nil "~,2F" *timefact*)                       :view-font '("Times" 18 :plain)))        (timeup (make-instance 'button-dialog-item                  :view-position #@(40 200)                  :view-size #@(14 14)                  :view-nick-name 'timeup                  :dialog-item-text "+"                  :view-font '("Times" 16 :plain)                  :border-p t                  :dialog-item-action #'(lambda (x)                                          (declare (ignore x))                                          (setf *timefact* (round1 (+ *timefact* .1) 2))                                          (set-dialog-item-text (view-named 'timefact self)                                                                (format nil "~,2F" *timefact*))                                          (format t "~%T fact changed to = ~S" *timefact*))))        (timedown (make-instance 'button-dialog-item                  :view-position #@(40 215)                  :view-size #@(14 14)                  :view-nick-name 'timedown                  :dialog-item-text "Ð"                  :view-font '("Times" 16 :bold)                  :border-p t                  :dialog-item-action #'(lambda (x)                                          (declare (ignore x))                                          (setf *timefact* (round1 (- *timefact* .1) 2))                                          (set-dialog-item-text (view-named 'timefact self)                                                                (format nil "~,2F" *timefact*))                                          (format t "~%T fact changed to = ~S" *timefact*))))        (tempfact (make-instance 'static-text-dialog-item                       :view-position #@(140 208)                       :view-nick-name 'tempfact                       :dialog-item-text (format nil "~,2F" *temp*)                       :view-font '("Times" 18 :plain)))        (mtitre (make-instance 'static-text-dialog-item                       :view-position #@(140 190)                       :dialog-item-text "mem lost"                       :view-font '("Times" 12 :plain)))        (tempup (make-instance 'button-dialog-item                  :view-position #@(120 200)                  :view-size #@(14 14)                  :view-nick-name 'tempup                  :dialog-item-text "+"                  :view-font '("Times" 16 :plain)                  :border-p t                  :dialog-item-action #'(lambda (x)                                          (declare (ignore x))                                          (setf *temp* (+ *temp* .05))                                          (set-dialog-item-text (view-named 'tempfact self)                                                                (format nil "~,2F" *temp*))                                          (format t "~%mem lost changed to = ~S" *temp*))))        (tempdown (make-instance 'button-dialog-item                  :view-position #@(120 215)                  :view-size #@(14 14)                  :view-nick-name 'tempdown                  :dialog-item-text "Ð"                  :view-font '("Times" 16 :bold)                  :border-p t                  :dialog-item-action #'(lambda (x)                                          (declare (ignore x))                                          (setf *temp* (- *temp* .05))                                          (set-dialog-item-text (view-named 'tempfact self)                                                                (format nil "~,2F" *temp*))                                          (format t "~%mem lost changed to = ~S" *temp*))))        (slopefact (make-instance 'static-text-dialog-item                       :view-position #@(220 208)                       :view-nick-name 'slopefact                       :dialog-item-text (format nil "~,2F" *t*)                       :view-font '("Times" 18 :plain)))        (stitre (make-instance 'static-text-dialog-item                       :view-position #@(220 190)                       :dialog-item-text "slope"                       :view-font '("Times" 12 :plain)))        (slopeup (make-instance 'button-dialog-item                  :view-position #@(200 200)                  :view-size #@(14 14)                  :view-nick-name 'tempup                  :dialog-item-text "+"                  :view-font '("Times" 16 :plain)                  :border-p t                  :dialog-item-action #'(lambda (x)                                          (declare (ignore x))                                          (setf *t* (+ *t* .05))                                          (set-dialog-item-text (view-named 'slopefact self)                                                                (format nil "~,2F" *t*))                                          (format t "~%slope changed to = ~S" *t*))))        (slopedown (make-instance 'button-dialog-item                  :view-position #@(200 215)                  :view-size #@(14 14)                  :view-nick-name 'tempdown                  :dialog-item-text "Ð"                  :view-font '("Times" 16 :bold)                  :border-p t                  :dialog-item-action #'(lambda (x)                                          (declare (ignore x))                                          (setf *t* (- *t* .05))                                          (set-dialog-item-text (view-named 'slopefact self)                                                                (format nil "~,2F" *t*))                                          (format t "~%slope changed to = ~S" *t*))))        )    (set-part-color name :text *white-color*)    (set-part-color time :text *white-color*)    (set-part-color freq1 :text *white-color*)    (set-part-color freq2 :text *white-color*)    (set-part-color freq2 :text *white-color*)    (set-part-color comment :text *white-color*)    (set-part-color timefact :text *white-color*)    (set-part-color tempfact :text *white-color*)    (set-part-color slopefact :text *white-color*)    (set-back-color self *red-color*)    (add-subviews self start-button end-button abort-button time name freq1 freq2                  comment next-button timeup timedown timefact tempup tempdown tempfact                  slopeup slopedown slopefact ttitre mtitre stitre)))#|(make-instance 'RESIN-control)|#