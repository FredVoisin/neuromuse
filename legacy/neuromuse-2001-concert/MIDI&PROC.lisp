;;;*****************************;;;*********** MIDI  ***********;;;*****************************;;*** MIDI init stuff ****(defvar *MIDI-console* (fred))(set-view-size *MIDI-console* 400 150)(set-view-position *MIDI-console* 0 40)(set-view-nick-name *MIDI-console* 'MIDI-CONSOLE)(SET-WINDOW-TITLE *MIDI-console* "MIDI-CONSOLE")(defun midiconsole (string)  (buffer-insert (fred-buffer *MIDI-console*)                 (format nil (concatenate 'string "~% " string )))  (FRED-UPDATE *MIDI-console*)  (values))(defparameter *refnum* nil)(defun list-appls ()  (midiconsole "List of MidiShare client applications")  (dotimes (i (midishare::MidiCountAppls))    (let ((ref (midishare::MidiGetIndAppl (1+ i))))      (midiconsole (format nil              " ~2d : reference number ~2d, name : '~a'"               (1+ i) ref (midishare::MidiGetName ref))))))(defun list-dest (ref1)  (midiconsole (format nil                       "List of the destinations of '~a' (ref num = ~d)"                        (midishare::MidiGetName ref1) ref1))   (dotimes (i (midishare::MidiCountAppls))     (let ((ref2 (midishare::MidiGetIndAppl (1+ i))))       (if (midishare::MidiIsConnected ref1 ref2)         (midiconsole (format nil " --> '~a' (ref num = ~d)"                              (midishare::MidiGetName ref2)                                ref2))))))(defun list-src (ref1)  (midiconsole (format nil                       "List of the sources of '~a' (ref num = ~d)"                        (midishare::MidiGetName ref1) ref1))   (dotimes (i (midishare::MidiCountAppls))     (let ((ref2 (midishare::MidiGetIndAppl (1+ i))))       (if (midishare::MidiIsConnected ref2 ref1)         (midiconsole (format nil " <-- '~a' (ref num = ~d)"                              (midishare::MidiGetName ref2)                                ref2))))))(defun init-midi ()  (if (midi-process-active-p)    (midiconsole "Can not open midi : midi process actives.")    (cond ((midishare::midishare)           (when *refnum* (midishare::midiclose *refnum*))           (setf *refnum* (midishare::midiopen "Common Lisp"))           (when (not (= 2 (midishare::midicountappls)))             (midiconsole "WARNING : there is already an midi application opened~& that is not Common Lisp or Midishare")             (values))           (midishare::MidiSetName (midishare::MidiGetNamedAppl "Common Lisp") "MCL")           (list-appls)           (midiconsole "  Connecting MCL and Midishare...~&")           (midishare::MidiConnect *refnum* 0 t)           (midishare::MidiConnect 0 *refnum* t)           (sleep 1)           (cond ((and (midishare::MidiIsConnected *refnum* 0)                       (midishare::MidiIsConnected 0 *refnum*))                  (midiconsole "Connected.~&"))                 (t (midiconsole "WARNING : No Connection, aborting.~&")                    (abort)))           (list-dest *refnum*)           (list-src 0)           (values))          (t (midiconsole "WARNING : No Midishare")))));(init-midi)(defun close-midi ()  (if (midi-process-active-p)    (midiconsole "Can not close MIDI : midi process actives.")    (cond ((midishare::midishare)           (midiconsole "  Closing MIDI...")           (midishare::midiclose *refnum*)           (midiconsole "MIDI closed."))          (t (midiconsole "WARNING : No Midishare")))))(defparameter *midi-monitor-process* nil)  ;(process-run-function '(:name "midi-monitor" :priority 2) #'midi-print *refnum*));(PROCESS-KILL *midi-monitor-process*)(defun process-info ()  (let ((info (list (mapcar #'process-name                            *ACTIVE-PROCESSES*)                    (mapcar #'process-whostate                            *ACTIVE-PROCESSES*)                    (mapcar #'process-priority                            *ACTIVE-PROCESSES*)))        (r '()))    (dotimes (n (length *ACTIVE-PROCESSES*))      (push (mapcar #'(lambda (x) (nth n x)) info) r))    (print (sort r '< :key #'third))));(process-info);;*** PROCESS functions ****(defvar *MIDI-PROCESS-NAMES* '("midi-monitor"))(defun midi-process-active-p ()  (if (eval (append '(or) (mapcar #'(lambda (x) (car (member (process-name x) *MIDI-PROCESS-NAMES* :test #'equalp)))                                  *ACTIVE-PROCESSES*)))    t nil));(midi-process-active-p)(defun KILL-ALL-MIDI-PROCESSES ()  (dolist (process *ACTIVE-PROCESSES*)    (when (member (process-name process) *MIDI-PROCESS-NAMES* :test #'equalp)      (PROCESS-KILL process)      (midiconsole (concatenate 'string "process " (process-name process) " killed.")))));(KILL-ALL-MIDI-PROCESSES)              ;;*** MIDI functions ****(defun waiting-events-p (refnum)    (> (midishare::midicountevs refnum) 0))(defun midi-print (refnum)  (loop    (do ((event (midishare::MidiGetEv refnum) (midishare::MidiGetEv refnum))         (time (get-time)))        ((%null-ptr-p event))      ;(print (list refnum event))      (format t "~%@ ~S:~S:~S : refnum ~S event type ~S." (nth 3 time) (nth 4 time) (nth 5 time) refnum (midishare::type event))       ;      ;(print (list (midishare::field event 0) (midishare::field event 1)))      )    (process-wait "waiting events" #'waiting-events-p refnum)))#|;;;*****************************;;;*********** MENUS ***********;;;*****************************(defvar *separation* (make-instance 'menu                       :menu-item-title "-"));;*** MIDI MENU ****(defvar *MIDI-menu* (make-instance 'menu))(set-menu-title *MIDI-menu* " PROC & MIDI ")(menu-install *MIDI-menu*)(defvar *init-midimenu* (make-instance 'menu-item                          :menu-item-title "INIT MIDI"                          :menu-item-action #'(lambda nil (init-midi))))(defvar *close-midimenu* (make-instance 'menu-item                           :menu-item-title "CLOSE MIDI"                           :menu-item-action #'(lambda nil (close-midi))))(defvar *midishare-MENU* (make-instance 'menu                         :menu-item-title "midishare"                         :menu-items (list *init-midimenu*                                           *close-midimenu*)))(set-menu-title *midishare-MENU* "midishare")(defvar *monitor-midi-off-menu*)(defvar *monitor-midi-on-menu* (make-instance 'menu-item                                 :MENU-ITEM-CHECKED nil                                 :menu-item-title "Monitor ON"                                 :menu-item-action #'(lambda nil                                                       (SET-MENU-ITEM-CHECK-MARK *monitor-midi-off-menu* nil)                                                       (SET-MENU-ITEM-CHECK-MARK *monitor-midi-on-menu* t)                                                       (midiconsole "monitoring midi...")                                                       (setf *midi-monitor-process*                                                             (process-run-function                                                               '(:name "midi-monitor" :priority 2)                                                              #'midi-print                                                               *refnum*)))))(setf *monitor-midi-off-menu* (make-instance 'menu-item                                  :MENU-ITEM-CHECKED t                                  :menu-item-title "Monitor OFF"                                  :menu-item-action #'(lambda nil                                                        (SET-MENU-ITEM-CHECK-MARK *monitor-midi-off-menu* t)                                                        (SET-MENU-ITEM-CHECK-MARK *monitor-midi-on-menu* nil)                                                        (midiconsole "midi monitor stopped")                                                        (PROCESS-KILL *midi-monitor-process*))))(defvar *MIDI-monitor-MENU* (make-instance 'menu                              :menu-item-title "MIDI monitor"                              :menu-items (list *monitor-midi-on-menu*                                                *monitor-midi-off-menu*)))(defvar *kill-midi-menu* (make-instance 'menu-item                                 :menu-item-title "kill all midi proc"                                 :command-key #\k                                 :menu-item-action #'(lambda nil (KILL-ALL-MIDI-PROCESSES))))(defvar *monitor-process-menu* (make-instance 'menu-item                                 :menu-item-title "MONITOR"                                 :menu-item-action #'(lambda nil (process-info))))(add-menu-items *MIDI-menu* *midishare-MENU* *MIDI-monitor-MENU* *separation* *kill-midi-menu* *separation* *monitor-process-menu*)|#;;;*****************************;;;******* INITIALISATION ******;;;*****************************(pushnew #'close-midi *lisp-cleanup-functions*)(init-midi)