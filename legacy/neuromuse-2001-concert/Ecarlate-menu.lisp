(defvar *separation* (make-instance 'menu                       :menu-item-title "-"))(defvar *chrono* (make-instance 'menu-item                      :menu-item-title "chrono"                      :menu-item-action #'(lambda ()                                            (make-instance 'chronometre :color *black-color* :name 'nero))));;*** MIDI MENU ****(defvar *MONITOR-MIDI-OFF-MENU* nil)(defvar *init-midimenu* (make-instance 'menu-item                          :menu-item-title "INIT MIDI"                          :menu-item-action #'(lambda nil (init-midi))))(defvar *close-midimenu* (make-instance 'menu-item                           :menu-item-title "CLOSE MIDI"                           :menu-item-action #'(lambda nil (close-midi))))(defvar *monitor-midi-on-menu* (make-instance 'menu-item                                 :MENU-ITEM-CHECKED nil                                 :menu-item-title "Monitor ON"                                 :menu-item-action #'(lambda nil                                                       (SET-MENU-ITEM-CHECK-MARK *monitor-midi-off-menu* nil)                                                       (SET-MENU-ITEM-CHECK-MARK *monitor-midi-on-menu* t)                                                       (midiconsole "monitoring midi...")                                                       (setf *midi-monitor-process*                                                             (process-run-function                                                               '(:name "midi-monitor" :priority 2)                                                              #'midi-print                                                               *refnum*)))))(setf *monitor-midi-off-menu* (make-instance 'menu-item                                  :MENU-ITEM-CHECKED t                                  :menu-item-title "Monitor OFF"                                  :menu-item-action #'(lambda nil                                                        (SET-MENU-ITEM-CHECK-MARK *monitor-midi-off-menu* t)                                                        (SET-MENU-ITEM-CHECK-MARK *monitor-midi-on-menu* nil)                                                        (midiconsole "midi monitor stopped")                                                        (PROCESS-KILL *midi-monitor-process*))))(defvar *MIDI-monitor-MENU* (make-instance 'menu                              :menu-item-title "MIDI monitor"                              :menu-items (list *monitor-midi-on-menu*                                                *monitor-midi-off-menu*)))(defvar *kill-midi-menu* (make-instance 'menu-item                                 :menu-item-title "kill all midi proc"                                 :command-key #\k                                 :menu-item-action #'(lambda nil (KILL-ALL-MIDI-PROCESSES))))(defvar *make-control-menu* (make-instance 'menu-item                              :menu-item-title "Sin CTL window"                              :menu-item-action #'(lambda nil (when (not (find-window "" 'resin-control))                                                                (make-instance 'RESIN-control)))))(defvar *monitor-process-menu* (make-instance 'menu-item                                 :menu-item-title "PROC monitor"                                 :menu-item-action #'(lambda nil (process-info))))(defvar *midishare-MENU* (make-instance 'menu                         :menu-item-title "MIDI"                         :menu-items (list *init-midimenu*                                           *close-midimenu*                                           *kill-midi-menu*)))(defvar *ECARLATE-menu* (make-instance 'menu                          :menu-item-title " * ECARLATE *"));; reso sinus menu(defvar *INIT-sin* (make-instance 'menu-item                                 :menu-item-title "INIT sinus"                                 ;:command-key #\                                 :menu-item-action #'(lambda nil (init-sin))))(defvar *NEXT-step* (make-instance 'menu-item                                 :menu-item-title "Next"                                 :command-key #\-                                 :menu-item-action #'(lambda nil (setf *GO* t))))(defvar *SIN-RESO* (make-instance 'menu                              :menu-item-title "RESO SINUS"                              :menu-items (list                                           *make-control-menu*                                           *INIT-sin*                                           *NEXT-step*)))(add-menu-items *ECARLATE-menu*                *chrono* *separation*                *midishare-MENU* *MIDI-monitor-MENU* *separation*                *SIN-RESO* *separation*                *monitor-process-menu*)(menu-install *ECARLATE-menu*)