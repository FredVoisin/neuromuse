(defvar *GO* nil)(setf *GO* nil)(defun send-ctl (ctl val ch)   (let ((event (midishare::MidiNewEv midishare::typeCtrlChange)))	; ask for a new note event     (unless (%null-ptr-p event)	; if the allocation was succesfull       (midishare::chan event ch)			; set the midi channel to 0 (means channel 1)       (midishare::port event 0)			; set the destination port to Modem       (midishare::field event 0 ctl)		; set the pitch field       (midishare::field event 1 val)		; set the velocity field       (midishare::MidiSendIm *refnum* event))	; send the note immediatly     ))(defun wait-for (time)  (when *GO* (setf *GO* nil))  (let ((start (float (/ (get-internal-real-time) internal-time-units-per-second))))    (loop          until (or (>= (- (float (/ (get-internal-real-time)                                     internal-time-units-per-second))                           start)                    time)                    *GO*)          do nil          ))  (when *GO* (setf *GO* nil))  (values));(wait-for 10)(defun init-sin ()    (setf *GO* nil)    (send-ctl 3 1 0)    (send-ctl 2 0 0)    (send-ctl 1 0 0)  (dotimes (n 74)    (wait-for .05)    (send-ctl (1+ n) 0 1)        (send-ctl (1+ n) 0 2)    )  );(init-sin)(defvar amp '(25 36 47 55 56 57 58 58 58 59 60 60 61 61 62 63 64 64 65 65 65 66 67 68 69 70 71 72 72 73 74 75 77 78 80 82 84 86 88 90 92 93 94 95 95 96 96 97 98 98 99 99 100 100 100 96 70 50 30 0))(defvar *t* .05)(defvar *timefact* 1.)(defvar *end* nil)(defvar *pert* 100)(defvar *TEMP* 0) ; temperature du reseau(defun run-sin ()    (gc)    (format t "~%> Initializing...")    (init-sin)    (format t "~%> init done.")    (setf *dur* (remove 0 *dur*))    (setf *end* nil)    (setf *t* .05)    (setf *timefact* 1.)    (let ((r (list (coerce '(.01 .2 .95) 'vector)))              (control-window (find-window "" 'resin-control))              (n 0)              (maindur 0)              (perturbation (scale *ecarts*                           (apply #'min *ecarts*)                          (apply #'max *ecarts*)                          0 127))              (perturb-length (length *ecarts*))       (trigsnd (scale *dur* (apply #'min *dur*) (apply #'max *dur*) 1 100)))    (setf (recurrent-layer-activation sin1C)  (coerce (make-list 8 :initial-element 0) 'vector))        (format t "~%> Starting reso...")        (loop until *end*                  do                  (incf n)                  (dotimes (n (length (recurrent-layer-activation sin1C)))           (setf (elt (recurrent-layer-activation sin1C) n )                 (+ (elt (recurrent-layer-activation sin1C) n )                    (* *TEMP* (random 1.0)))))                  (let (deltaT)                      (push (run-mlp sin1C                          (print (concatenate 'vector (coerce (list *t*) 'vector)                                              (car r)))                          :thresh 1 :slope 1)                                 r)                                            (setf deltaT (* *timefact* (scale (elt (car r) 2) .0 1. 1 20.))                               maindur (+ maindur deltat))                      (format t "~%> STEP ~S -> Delta T = ~,3F ~%Time = ~D:~D" n deltaT                                    (floor (/ (round maindur) 60))                                    (mod (round maindur) 60))                      (when control-window                           (set-dialog-item-text (view-named 'time control-window)                                    (format nil "~D'~D\""                                            (floor (/ (round maindur) 60))                                            (mod (round maindur) 60)))              (set-dialog-item-text (view-named 'freq1 control-window)                                    (format nil "~4F" (elt (car r) 0))))           (send-ctl 1 (round (scale maindur .0 1190. 0 127)) 4) ;time           (when (> maindur 90) ; pas tout de suite...             (send-ctl 2 (round                          (nth (floor (* (min 1. (/ maindur 1160)) (1- (length trigsnd)))) trigsnd))                                             4))           (send-ctl 3 (round (scale deltaT 1. 20. 0 127)) 0)           (send-ctl 2 (nth (floor (* (min 1. (/ maindur 1160)) (1- (length amp)))) amp) 0)                      (send-ctl 1 (round (scale (elt (car r) 0) .0 .95 0 127)) 0)           (dotimes (n 74)             (wait-for (float (/ deltat 75)))             (send-ctl (1+ n)                                               (random (+ 50 *pert*))                       3)                          (send-ctl (1+ n)                                              (+ 50  (random *pert*))                       2)                          (send-ctl (1+ n)                       (round (nth (round (* (elt (car r) 1) perturb-length)) perturbation))                       1))                      (when (> maindur 1200)                           (setf *end* t)                           (format t "~%> End reached..."))           ))        (send-ctl 3 120 0)        (send-ctl 2 0 0)    (dotimes (n 74)             (wait-for .05)             (send-ctl (1+ n) 0 2)                          )        )    (format t "~%sin DONE.")    (values)    )(defvar *GEL-PROCESS* (make-process "resin"))(process-preset *GEL-PROCESS* #'run-sin);(type-of *GEL-PROCESS*);(process-enable *GEL-PROCESS*)