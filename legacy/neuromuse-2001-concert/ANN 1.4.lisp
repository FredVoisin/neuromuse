utton*  ;thermometre error          (make-instance 'button-dialog-item            :dialog-item-text "Break"            :view-container *monitor-window*            :view-position #@(160 185)            :dialog-item-action #'(lambda (item)                                    (declare (ignore item))                                   (break))))        ))#|(make-monitor-window time-LH1)|#(window-close *monitor-window*)(defun scale-th-error (x)    (if (<= x 0) 0        (round (* 15 (+ 5 (log (* 1000 x) 5))))))(defclass view-mlp (ccl::scrolling-window)  ((data    :initarg :data    :initform '()    :reader data    :accessor data    :type list)   (scalex    :initarg :scalex    :initform 1.0    :reader scalex    :accessor scalex    :type number)   (scaley    :initarg :scaley    :initform 1.0    :reader scaley    :accessor scaley    :type number)    )  (:documentation "trace window 2 dim.")  )#|(defmethod view-draw-contents ((self view-perceptron))  (call-next-method)    (let ((data (data self))        (scalex (scalex self))        (scaley (scaley self))        )    (dotimes (i (array-dimension data 1))      (dotimes (j (array-dimension data 0))        (move-to self (+ 22 (* (1+ i) 20) (round (* scalex i))) (+ 22 (round (* scaley j))))        (draw-string (format nil "~,2F" (aref data j i)))))))|#(defmethod view-draw-contents ((self view-mlp))  (call-next-method)    (let ((data (data self))        (scalex (scalex self))        (scaley (scaley self))        )    (dotimes (n (length data))      (dotimes (i (array-dimension (nth n data) 1))        (move-to self (+ 22 (* (1+ i) 20) (round (* scalex i))) (+ 22 (round (* n scaley))))        (dotimes (j (array-dimension (nth n data) 0))          (set-fore-color self (if (minusp (aref (nth n data) j i))                                 (round (- *blue-color* 100 (* -40 (abs (aref (nth n data) j i)))))                                 (round (- *red-color* 100 (* -35 (aref (nth n data) j i))))))          (line-to self (+ 22 (* (1+ j) 20) (round (* scalex j))) (+ 22 (round (* (1+ n) scaley))))          (move-to self (+ 22 (* (1+ i) 20) (round (* scalex i))) (+ 22 (round (* n scaley)))))))))(defun make-mlp-window (data scalex scaley)  (make-instance 'view-mlp    :view-font '("times" 9)    :data (net data)    :scalex scalex    :scaley scaley    :scroller-class 'scroller    :window-type :document-with-zoom    :window-title (string (name data))    :view-size (make-point (round (* 2 scalex (apply #'max (mapcar #'(lambda (n)                                                                       (1+ (array-dimension n 1)))                                                                   (net data)))))                           (+ 50 (round (* (length (net data)) scaley))))    :track-thumb-p t));(view (make-mlp-window ann 20 150));(setf v (make-mlp-window id1 20 150));(update-net-window v identity448)(defmethod update-net-window ((self view-mlp) (ann mlp))  (setf (data self) (net ann)))(defmethod update-net-window ((self null) (ann mlp))  nil)#|(mlp iii 8 8 16 10)(make-mlp-window rtest 20 150)(clear id1)(make-mlp-window id1 20 150)(make-mlp-window identity448 20 150)|#(defmethod make-field ((text string) (h integer) (v integer) &key color size container)  (let ((view (make-dialog-item 'static-text-dialog-item                                 #@(3 9)                                 (if size size #@(90 16))                                text                                'nil                                :view-container container                                :part-color-list (if color                                                   (list :body color)                                                   '(:body 10461087)))))    (set-view-position view h v)    view))(defmethod make-field ((text list) (h list) (v list) &key color size)  (mapcar #'(lambda (txt x y) (make-field txt x y :color color :size size)) text h v))(defmethod make-field ((text list) (h list) (v integer) &key color size)  (mapcar #'(lambda (txt x) (make-field txt x v :color color :size size)) text h));; TRACE HISTORIQUE(defclass trace-WINDOW (ccl::scrolling-window)  ((data    :initarg :data    :initform '()    :reader data    :accessor data    :type list)   (scalex    :initarg :scalex    :initform 1.0    :reader scalex    :accessor scalex    :type number)   (scaley    :initarg :scaley    :initform 1.0    :reader scaley    :accessor scaley    :type number)   (legend    :initarg :legend    :initform '("x")    :reader legend    :accessor legend    :type list)      )  (:documentation "trace window 2 dim.")  )(defmethod view-draw-contents ((self trace-window))  (call-next-method)    (let ((data (data self))        (scalex (scalex self))        (scaley (scaley self)))    (if (member 't (mapcar #'listp data))      (dolist (d data)        (trace-pt self d scalex scaley))      (trace-pt self data scalex scaley))    ))(defun trace-pt (self data scalex scaley)  (let ((miny  0)) ;(apply #'min data)))  (dotimes (i (length data))    (if (= 0 i)       (move-to self 25 (round (* scaley (- (car data) miny))))      (line-to self                (+ 25 (round (* scalex i)))               (+ 25 (round (* scaley (- (nth i data) miny)))))      ))))(defun make-trace-window (data scalex scaley legend)        (make-instance 'trace-window      :data data      :scalex scalex      :scaley scaley      :legend legend      :window-title legend      :scroller-class 'scroller      :window-type :document-with-zoom      :view-size #@(200 300)      :track-thumb-p t))#|(make-trace-window (list (subseq *history-error* 0 6000)) .1 100.0 '("1"))|#;; pour OM si present  (defun omsort (list test key)  (sort list test :key key))(setf *MINIMUM-STACK-OVERFLOW-SIZE* 4000000)(warning (format nil "> Minimum stack overflow size