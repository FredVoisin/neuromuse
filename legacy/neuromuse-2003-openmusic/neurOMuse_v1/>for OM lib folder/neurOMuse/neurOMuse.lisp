-files* nil)(setf  *neuromuse-files* '(                                          "CL:UserLibrary;neurOMuse;neurOMuse sources;neuromuse#04.lisp"                                          "CL:UserLibrary;neurOMuse;neurOMuse sources;neurOM-windows.lisp"                                          "CL:UserLibrary;neurOMuse;neurOMuse sources;neurOM-thermometer.lisp"                                          "CL:UserLibrary;neurOMuse;neurOMuse sources;dynamic-views.lisp"                                          "CL:UserLibrary;neurOMuse;neurOMuse sources;neuromuse-to-OM.lisp"                                                                                    ));--------------------------------------------------;Loading & compiling files ;--------------------------------------------------(mapc #'ccl::COMPILE&LOAD *neuromuse-files*);(mapc #'ccl::load *neuromuse-files*);--------------------------------------------------(defvar *subpackages-neuromuse* nil)(setf *subpackages-neuromuse*         '(("make ann" nil nil (mlp*                                          rcmlp*                                          lvq*                                          ) nil)           ("learn" nil nil (train-mlp                                   train-rcmlp                                   train-aam                                   ) nil)           ("run" nil nil (                                run-nn                                ) nil)           ("data-handle" nil nil (                                              intextrapom                                              list2vector                                              vector2list                                              ) nil)           ("utils" nil nil (nnfind                                 open-nn                                 net-view                                 export-nn                                 load-nn                                 ) nil)));--------------------------------------------------;filling packages;--------------------------------------------------(om::fill-library *subpackages-neuromuse*)