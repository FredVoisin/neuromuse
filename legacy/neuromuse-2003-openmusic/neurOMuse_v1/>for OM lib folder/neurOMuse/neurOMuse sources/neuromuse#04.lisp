%");; updated sept. 15 2003;;; *********************************************************;;; ********************  PACKAGE *******************;;; *********************************************************#|(defpackage "neuromuse#0"  (:use "COMMON-LISP" "CCL")  (:import-from "CCL")  (:nicknames "neuromuse"))(in-package "neuromuse")(setf *package* (find-package "neuromuse"))(setf ccl:*lisp-startup-functions*      (append ccl:*lisp-startup-functions*              (list #'(lambda ()                        (setf *package* (find-package :neuromuse#0))))))|#; for old version of code without graphic methods(defvar *CURRENT-EPOCH* 0) (defvar *TH-ERROR* nil)(defvar *TH* nil)(defvar *TH-ERROR-SAMPLE* nil)(defvar *HISTORY-ERROR* nil);(get-def (first (windows)))(defvar version "0.3")(defvar *ann-dir* (if *load-pathname*                    (directory-namestring *load-pathname*)                    nil))(if (not *ann-dir*)  (setf *ann-dir* (directory-namestring (choose-directory-dialog                                         :prompt (concatenate 'string "Select folder for " version "..."))))  (format t "Using directory ~S~%" *ann-dir*))(when (not (member *ann-dir* *module-search-path*))  (push *ann-dir* *module-search-path*));;; *********************************************************;;; ********************  VARIABLES GENERALES  **************;;; *********************************************************(defvar *e* '(0))(defvar *max-stop-epoch* 100000)(defvar *pause* 0.0001);;*****************************************************************;;    CLASSES definitions;;*****************************************************************(defclass ANN ()  ((creation-date :initform 'nil :initarg :creation-date :reader creation-date :accessor creation-date :type list)   (modification-date :initform '() :initarg :modification-date :reader modification-date :accessor modification-date :type list)   (epoch :initform  0  :initarg :epoch :reader epoch :accessor epoch  :type integer)   (history-error :initform  '()  :initarg :history-error :reader history-error :accessor history-error  :type list)   (current-error :initform 1000 :initarg :current-error :reader current-error :accessor current-error  :type float)   (last-error :initform 1000 :initarg :last-error :reader last-error  :accessor last-error  :type float)   (last-stop :initform '(0 nil) :initarg :last-stop :reader last-stop :accessor last-stop :type list)   (history :initform '() :initarg :history :reader history :accessor history :type list)   (temp :initform 0.0 :initarg :temp :reader temp :accessor temp :type float)   (inhibit :initform '() :initarg :inhibit  :reader inhibit :accessor inhibit :type list)   (inhibit-fact :initform '() :initarg :inhibit-fact :reader inhibit-fact :accessor inhibit-fact :type list)   (inhibit-run :initform nil :initarg :inhibit-run :reader inhibit-run :accessor inhibit-run  :type symbol)   (inhibit-learn :initform nil :initarg :inhibit-learn :reader inhibit-learn :accessor inhibit-learn :type symbol)   (parent :initform 'nil :initarg :parent :reader parent :accessor parent :type symbol)   (saved :initform '() :initarg :saved :reader saved :accessor saved :type symbol)   (color :initform *black-color* :initarg :color :reader color :accessor color :type integer))  (:documentation "Classe generale de reseaux de neurones artificiels"))(defmethod ann-p ((self ann))  t)(defmethod ann-p ((self t))  nil)(defclass perceptron (ANN)  ((name    :initform 'perceptron    :initarg :name    :reader name    :accessor name    :type symbol)   (in-size    :initform 2    :initarg :in-size    :reader in-size    :accessor in-size    :type integer)   (out-size    :initform 1    :initarg :out-size    :reader out-size    :accessor out-size    :type integer)   (net    :initform #2a((0.8706776422833606) (0.6620371149145758))    :initarg :net    :reader net    :accessor net    :type array)   (previous    :initform '()    :initarg :previous    :reader previous    :accessor previous    :type array)   )  (:documentation "perceptron")  )(defmethod net ((self symbol))  (net (eval self)))(defmethod net ((self list))  self)(defmethod print-object ((object perceptron) stream)  (format stream          "<perceptron ~S ~D input~:P ~D output~:P>"           (string (name object))          (array-dimension (net object) 0)          (array-dimension (net object) 1))  (values))#|(make-instance 'perceptron)|#(defun warning (string)  (format t (concatenate 'string "~% WARNING : " string))  )(defmacro perceptron (name in out)  (cond ((not (boundp name))         (let ((net                (make-instance 'perceptron                  :name name                  :in-size in                  :out-size out                   :net (init-perceptron in out)                  :creation-date (get-time))))           `(defvar ,name ,net)           ))        ((ann-p (symbol-value name))         (warning (format nil "~S already exists, is a ~S.~%Can't create perceptron ~S."                          name                          (type-of (symbol-value name))                          name)))        (t         (let ((net                (make-instance 'perceptron                  :name name                  :in-size in                  :out-size out                   :net (init-perceptron in out)                  :creation-date (get-time))))           `(setf ,name ,net)           ))))#|(perceptron x 10 1)x(net x)(class-of x)(type-of x)(ann-p x)|#(defclass MLP (ann)  ((name    :initform 'perceptron    :initarg :name    :reader name    :accessor name    :type symbol)   (in-size    :initform 2    :initarg :in-size    :reader in-size    :accessor in-size    :type integer)   (out-size    :initform 1    :initarg :out-size    :reader out-size    :accessor out-size    :type integer)   (hidden-size    :initform 2    :initarg :hidden-size    :reader hidden-size    :accessor hidden-size    :type integer)   (net    :initform '()    :initarg :net    :reader net    :accessor net    :type list)   (previous :initform '()  :initarg :previous :reader previous :accessor previous :type list)   )  (:documentation "MLP"))(defmethod print-object ((object MLP) stream)  (format stream          "<mlp ~S: ~D cell~:P, ~D in~:P, ~D hidden-layer~:P, ~D out~:P>"          (string (name object))          (apply #'+ (append (list (in-size object) (out-size object)) (hidden-size object)))          (in-size object)          (length (hidden-size object))          (out-size object)          )  (values))(defmacro MLP (name in out &rest hid)  (cond ((not (boundp name))         (let ((net                (make-instance 'mlp                  :name name                  :in-size in                  :hidden-size hid                  :out-size out                  :last-error 1000                  :net (apply #'init-mlp (append (list in out) hid))                  :creation-date (get-universal-time))))           `(defvar ,name ,net)           ))        ((ann-p (symbol-value name))         (symbol-value name)         ;(warning (format nil "~S already exists, is a ~S.~%Can't create MLP with name ~S." name (type-of (symbol-value name))  name))         )        (t         (let ((net                (make-instance 'mlp                  :name name                  :in-size in                  :hidden-size hid                  :out-size out                  :last-error 1000                  :net (apply #'init-mlp (append (list in out) hid))                  :creation-date (get-universal-time))))           `(setf ,name ,net)           ))))#|(mlp u 10 5 1)u(net u)(type-of u)|#(defclass MLPj (mlp)  ((recurrent-layer    :initform 0    :initarg :recurrent-layer    :reader recurrent-layer    :accessor recurrent-layer    :type integer)   (recurrent-layer-activation    :initform nil    :initarg :recurrent-layer-activation    :reader recurrent-layer-activation    :accessor recurrent-layer-activation    :type vector)   )  (:documentation "MLP de jordan"))(defmethod print-object ((object MLPj) stream)  (format stream          "<rec-mlp ~S: ~D cell~:P, ~D in~:P, ~D hidden-layer~:P, ~D out~:P>"          (string (name object))          (apply #'+ (append (list (in-size object) (out-size object)) (hidden-size object)))          (in-size object)          (length (hidden-size object))          (out-size object)          )  (values))(defmacro MLPj (name in out &rest hid)  (cond ((not (boundp name))         (let ((net                (make-instance 'mlpj                  :name name                  :in-size in                  :hidden-size hid                  :out-size out                  :last-error 1000                  :net (apply #'init-mlp (append (list in out) hid))                  :creation-date (get-universal-time))))           `(defvar ,name ,net)           ))        ((ann-p (symbol-value name))         (warning (format nil "~S already exists, is a ~S.~%Can't create MLP-J with name ~S."                          name                          (type-of (symbol-value name))                          name)))        (t         (let ((net                (make-instance 'mlpj                  :name name                  :in-size in                  :hidden-size hid                  :out-size out                  :last-error 1000                  :net (apply #'init-mlp (append (list in out) hid))                  :creation-date (get-universal-time))))           `(setf ,name ,net)           ))))(defmethod backpropagate ((mlp mlpj) (input vector) (output vector)                           &key (learn 1.0) (error 0) (temp 0) (slope 1.0) (clip nil)                          (hidden-func #'logistic) (out-func #'logistic)                          (thresh 0) n)  (let ((hidden-answer-cell (list))        output-answer-cell        out-signal-error        (hidden-signal-error (list))        (e 1000))    (if (> n 0)      (dotimes (n (nth (recurrent-layer mlp) (hidden-size mlp)))        (setf (aref input (+ (in-size mlp) n)) (elt (recurrent-layer-activation mlp) n))        )      (dotimes (n (nth (recurrent-layer mlp) (hidden-size mlp)))        (setf (aref input (+ (in-size mlp) n)) 0)))    (dotimes (down (- (length (net mlp)) 1))  ;; 1- activation = top->down      (if (zerop down)        (push (funcall hidden-func (multiply-matrix-and-vector (car (net mlp)) input)                       :temp temp                       :slope slope                       :thresh thresh)              hidden-answer-cell)        (push (funcall hidden-func (multiply-matrix-and-vector (nth down (net mlp)) (car hidden-answer-cell))    ;(nth (1- down) hidden-answer-cell))                       :temp temp                       :slope slope                       :thresh thresh)              hidden-answer-cell)))    (setf (recurrent-layer-activation mlp) (nth (recurrent-layer mlp) (reverse hidden-answer-cell))          output-answer-cell (funcall out-func (multiply-matrix-and-vector (car (last (net mlp))) (car hidden-answer-cell))                                      :temp temp                                      :slope slope                                      :thresh thresh)          out-signal-error (output-signal-error output output-answer-cell)          e (apply #'+ (check-error output-answer-cell output error)))    (if (< e error)      (progn ()             (format t "~% Error reached : no backpropagation.")             (values mlp e))      (progn ()             (dotimes (up (length hidden-answer-cell))  ;; 2- signal error = bottom->up               (if (zerop up)                 (push (hidden-signal-error (car hidden-answer-cell)                                            (hidden-error-estimation                                             (error-retropopagation (car (last (net mlp))) out-signal-error)))                       hidden-signal-error)                 (push (hidden-signal-error (nth up hidden-answer-cell)                                            (hidden-error-estimation                                             (error-retropopagation (nth (- (length (net mlp)) up 1)  (net mlp))                                                                    (car hidden-signal-error)))) ;(nth (- up 1)                       hidden-signal-error)))             (setf hidden-answer-cell (reverse hidden-answer-cell))             (dotimes (down (length hidden-signal-error))  ;;3- update = top->down               (if (zerop down)                 (setf (car (net mlp)) (update-hidden-weights (car (net mlp)) input                                                              (car hidden-signal-error) learn clip))                 (setf (nth down (net mlp)) (update-hidden-weights (nth down (net mlp)) (nth (- down 1) hidden-answer-cell)                                                                   (nth down hidden-signal-error) learn clip))))             (setf (car (last (net mlp))) (update-output-weights (car (last (net mlp))) (car (last hidden-answer-cell))                                                                 out-signal-error learn clip))                          (values mlp e)))))(defmethod learn ((ann mlpj) (input list) (goal list)                   &key                  (temp 0) (learn 1.0) (slope 1.0)                  (input-func nil)                  (hidden-func #'logistic) (out-func #'logistic) (clip nil)                  (thresh 0) (error 0.001) (stop *max-stop-epoch*) (method nil) (verbose nil))  (setf (previous ann) (copy-net ann))  ; backup of previous state  (setf (recurrent-layer-activation ann) (copy-tree (make-list (nth (recurrent-layer ann) (hidden-size ann)) :initial-element 0)))  (let ((temp-error '())        (learn-view (find-window (concatenate 'string "Learning for " (string (name ann))) 'learn-window))        (net-view (find-window (concatenate 'string "Net of " (string (name ann))) 'net-window))        max)    (dotimes (n (length input))      (multiple-value-bind (mlp e)                           (backpropagate ann (if input-func                                                 (funcall input-func (concatenate 'vector (nth n input)                                                                                 (recurrent-layer-activation ann)))                                                (concatenate 'vector (nth n input)                                                             (recurrent-layer-activation ann)))                                          (nth n goal)                                          :learn learn :error error :temp temp :slope slope :clip clip                                          :hidden-func hidden-func :out-func out-func :thresh thresh :n n)        (push e temp-error)        (when learn-view          (ccl::thermometer-update-values-2 (view-named 'error-th learn-view) (scale-th-error (* e e))))        (sleep *pause*)        (values mlp)))    (setf (current-error ann) (car (history-error ann)))    (push (float (/ (apply #'+ (mapcar #'(lambda (x) (* x x)) temp-error)) (out-size ann))) (history-error ann))    (setf (epoch ann) (incf (epoch ann))          max (if (car (last-stop ann)) (+ (car (last-stop ann)) stop) stop))    (when learn-view      (ccl::thermometer-update-values-2 (view-named 'mean-th learn-view) (let ((lerror (scale-th-error (car (history-error ann)))))                                                                           (list lerror                                                                                 (- (scale-th-error (last-error ann)) lerror))                                                                           ))      (ccl::thermometer-update-values-2 (view-named 'epoch-th learn-view) (round (* 100 (- (epoch ann)                                                                                           (car (last-stop ann))))                                                                                 stop )))    (cond ((<= (car (history-error ann)) error)           (format t "~%> Learning COMPLETED at epoch ~D with error = ~D." (epoch ann) (car (history-error ann)))           (setf (last-stop ann) (list (epoch ann) 'completed))           (setf (last-error ann) (car (history-error ann)))           (update-learning-info ann (GET-UNIVERSAL-TIME) (epoch ann) input goal learn temp thresh method out-func hidden-func)           (beep)           ann)          ((>= (epoch ann) max)           (format t "~%> Learning INTERRUPTED at epoch ~D with error = ~D " (epoch ann) (car (history-error ann)))           (setf (last-stop ann) (list (epoch ann) 'interrupted))           (setf (last-error ann) (car (history-error ann)))           (update-learning-info ann (GET-UNIVERSAL-TIME) (epoch ann) input goal learn temp thresh method out-func hidden-func)           (beep)           ann)          (t            (when verbose             (format t "~%> Learning at epoch ~D with error = ~D" (epoch ann) (car (history-error ann))) )           (when net-view ;(and (eq ann (ann view)) view )             (invalidate-view net-view))           (learn ann input goal                  :learn learn :error error :temp temp :method method                  :hidden-func hidden-func :out-func out-func :thresh thresh :stop stop :verbose verbose)))))(defmethod run-mlpj ((mlp mlpj) (input vector)  &key (hidden-func #'logistic) (out-func #'logistic) (temp 0) (thresh 0) (slope 1.0))  (let ((hidden-answer-cell (list))        (net (net mlp)))    (dotimes (w (- (length net) 1))      (if (zerop w)        (push (funcall hidden-func (multiply-matrix-and-vector (car net) input)                       :slope slope :temp temp :thresh thresh) hidden-answer-cell)        (push (funcall hidden-func (multiply-matrix-and-vector (nth w net) (car hidden-answer-cell))                        :slope slope :temp temp :thresh thresh)              hidden-answer-cell)))    (setf (slot-value mlp 'recurrent-layer-activation) (nth (recurrent-layer mlp) (reverse hidden-answer-cell)))    (funcall out-func (multiply-matrix-and-vector (car (last net)) (car hidden-answer-cell))             :slope slope :temp temp :thresh thresh)))(defmethod run-mlp ((mlp mlpj) (input vector)  &key (hidden-func #'logistic) (out-func #'logistic) (temp 0) (thresh 0) (slope 1.0))  (if (not (inhibit-run mlp))    (run-mlpj mlp (coerce (append (coerce input 'list)                                  (coerce (recurrent-layer-activation mlp) 'list)) 'vector)              :hidden-func hidden-func :out-func out-func :temp temp :thresh thresh :slope slope)    (let ((hidden-answer-cell (list))          (inhib-out (match-i (1- (length (net mlp))) (inhibit mlp))))      (dotimes (w (- (length (net mlp)) 1))        (let ((inhibited (match-i w (inhibit mlp))))          (if (zerop w)            (push (funcall hidden-func (multiply-matrix-and-vector                                         (inhibit-synaps (car (net mlp))                                                        (car inhibited)                                                        (cadr inhibited) :factor 0)                                        input)                           :slope slope :temp temp :thresh thresh) hidden-answer-cell)            (push (funcall hidden-func (multiply-matrix-and-vector (inhibit-synaps (nth w (net mlp))                                                                                   (car inhibited)                                                                                   (cadr inhibited) :factor 0)                                                                   (car hidden-answer-cell))                           :slope slope :temp temp :thresh thresh)                  hidden-answer-cell))))      (funcall out-func (multiply-matrix-and-vector (inhibit-synaps (car (last (net mlp)))                                                                    (car inhib-out)                                                                    (cadr inhib-out) :factor 0)                                                    (car hidden-answer-cell))               :slope slope :temp temp :thresh thresh))))(defmethod save ((ann mlpj) &optional file)  (let ((data (net ann))        (new? t))    (if (saved ann)      (if (probe-file (saved ann))        (and (setf file (saved ann))  (setf new? nil))        (if (Y-OR-N-DIALOG (format nil                                   "Sorry, can't find saved version of ~S."                                   (name ann))                           :yes-text "Find it"                           :no-text "New file")          (and (setf file (choose-file-dialog                           :mac-file-creator 'fann                           :mac-file-type :text                           :button-string (format nil "~S..."  (name ann))))               (setf new? nil))          (setf file (choose-new-file-dialog                      :name (format nil "~S" (name ann))                      :prompt "Save Jordan MLP as..."))))      (setf file (choose-new-file-dialog                  :name (format nil "~S" (name ann))                  :prompt "Save Jordan MLP as...")))    (with-open-file (out file                         :direction :output                         :if-exists :append                         :if-does-not-exist :create)      (when new?        (format out "(defvar ~S '~S)~%~%" (name ann) (name ann)))      (format out "~%~%(setf ~S (make-instance 'MLPJ~%" (name ann))      (format out ":name (quote ~S)~%" (name ann))      (format out ":parent (quote ~S)~%" (parent ann))      (format out ":current-error ~F~%" (current-error ann))      (format out ":history-error '~S~%" (history-error ann))      (format out ":last-error ~F~%" (last-error ann))      (format out ":last-stop (quote ~S)~%" (last-stop ann))      (format out ":epoch ~D~%" (epoch ann))      (format out ":in-size ~S~%" (in-size ann))      (format out ":hidden-size '~S~%" (hidden-size ann))      (format out ":out-size ~S~%" (out-size ann))      (format out ":recurrent-layer ~S~%" (recurrent-layer ann))      (format out ":recurrent-layer-activation ~S~%" (recurrent-layer-activation ann))      (format out ":inhibit '~S~%" (inhibit ann))      (format out ":inhibit-fact '~S~%" (inhibit-fact ann))      (format out ":inhibit-run ~S~%" (inhibit-run ann))      (format out ":inhibit-learn ~S~%" (inhibit-learn ann))      (format out ":net '~S~%" data)      (format out ":previous '~S~%" (previous ann))      (format out ":creation-date ~S~%" (creation-date ann))      (format out ":modification-date '~S~%" (modification-date ann))      (format out (format nil ":saved ~S" file))      (format out "))~%")      ;(format out "(print ~S)~%" (name ann))      (setf (saved ann) file)      (set-mac-file-creator file 'FANN)      (set-mac-file-type file :TEXT)      (format t "MLP-j ~S saved into file ~S.~%" (name ann) file)      (save-history ann                    (make-pathname :directory (pathname-directory file)                                   :name (concatenate 'string (pathname-name file) "-H")))      (format t "please wait...~%" )      (format t "History saved.~%" )      (values))))(defmacro make-history (ann &optional data)  (let ((full-name (read-from-string (concatenate 'string (string (name (eval ann))) "-history"))))    `(defvar ,full-name ,data)    ));;*****************************************************************;;;;;                      PERCEPTRON feedforward a temperature;;*****************************************************************(defmethod init-perceptron ((in-size integer) (out-size integer))  "initialisation random d'un net."  (let ((init-net (make-array (list in-size out-size))))    (dotimes (i in-size init-net)      (dotimes (j out-size)        (setf (aref init-net i j) (- .2 (random 0.4)))))))(defmethod init-perceptron ((in-size null) (out-size null))  "initialisation random d'un net."  (setf in-size 2        out-size 1)  (init-perceptron in-size out-size))(defun cell-states (j net)  "vecteur des poids des synapses connectees a la cellule de sortie j."  (let ((activity-j '()))    (dotimes (i (array-dimension net 0)                (apply #'vector (nreverse activity-j)))      (push (aref net i j) activity-j))))(defun cell-activity-1 (j input net)  (vector-sum   (multiply-2-vectors input (cell-states j net))))(defmethod cell-activity ((j integer) (input t) (net t))  (cell-activity-1 j input net))(defmethod cell-activity ((j list) (input t) (net t))  (mapcar #'(lambda (cell) (cell-activity-1 cell input net)) j))(defmethod cell-activity ((j vector) (input t) (net t))  (assert (vectorp j))  (let ((r '()))    (dotimes (n (length j) (apply #'vector (nreverse r)))      (push (cell-activity-1 (aref j n) input net) r))));; perceptron a temperature a la Boltzmann(defmethod run-perceptron ((input vector) (net t) &key (thresh 0) (temp 1.0) (func #'logistic) (slope 1))  (let ((cell-outputs '()))    (dotimes (j (array-dimension net 1) (apply #'vector (nreverse cell-outputs)))      (push (funcall func (cell-activity j input net) :temp temp :thresh thresh :slope slope)            cell-outputs))))(defmethod run-perceptron ((input list) (net t) &key (thresh 0) (temp 1.0) (func #'logistic) (slope 1))  (assert (not (member 'nil (mapcar #'vectorp input))))  (mapcar #'(lambda (x)              (run-perceptron x net                              :func func                              :temp temp                              :thresh thresh                              :slope slope))          input))(defmethod run-perceptron ((input t) (net t) &key (thresh 0) (temp 1.0) (func #'logistic) (slope 1))  (run-perceptron (eval `(,input)) net                  :func func                  :temp temp                  :thresh thresh                  :slope slope))(defmethod run ((net perceptron) (input vector) &key (thresh 0) (temp 1.0) (func #'logistic) (slope 1))  (run-perceptron input (net net)                   :func func                  :temp temp                  :thresh thresh                  :slope slope))(defmethod run ((net perceptron) (input list) &key (thresh 0) (temp 1.0) (func #'logistic) (slope 1))  (mapcar #'(lambda (stimulus) (run net stimulus                                     :func func                                    :temp temp                                    :thresh thresh                                    :slope slope))          input))(defmethod run ((net symbol) (input list) &key (thresh 0) (temp 1.0) (func #'logistic) (slope 1))  (run (eval net) input :temp temp :thresh thresh :func func :slope slope))(defmethod run ((net symbol) (input vector) &key (thresh 0) (temp 1.0) (func #'logistic) (slope 1))  (run (eval net) input :temp temp :thresh thresh :func func :slope slope));; noyau apprentissage perceptron par la regle de widrow-hoff(defun perceptron-learn (input goal net &key (thresh 0) (learn 1.0) (temp 1.0) (func #'logistic) (slope 1) (verbose nil))  (when (symbolp input)    (setf input (eval `(,input))))  (let ((input-length (array-dimension net 0))        (output-length (array-dimension net 1))        (net-output (run-perceptron input net :temp temp :func func :thresh thresh :slope slope)))    (when verbose      (format t "~% Input = ~S; Goal = ~S ; Output is = ~S." input goal net-output))    (dotimes (i input-length net)      (let ((xi (aref input i)))        (dotimes (j output-length)          (let ((wijt+1 (widrow-hoff                         (aref net i j)                         (aref goal j)                         (aref net-output j)                         xi                         learn)))            (setf (aref net i j)                  wijt+1)))))    (values net)))(defmethod train-percep ((stimuli t) (goals t) (ann perceptron) (s-res t) &key func slope thresh temp learn error stop verbose)  (assert (= (length stimuli) (length goals)))  (let (new-output        (epoque-result '()))    (dotimes (n (length stimuli) )       (setf net (perceptron-learn (nth n stimuli)                                  (nth n goals)                                  net                                  :temp temp                                  :learn learn                                  :func func                                  :slope slope                                  :thresh thresh                                  :verbose verbose)))    (setf new-output (run-perceptron stimuli net :temp temp :thresh thresh :func func :slope slope)          epoque-result (apply #'append (mapcar #'(lambda (a b) (compare-vectors a b error)) goals new-output)))    (format t "~% Epoch ~S : ~S errors" (epoch ann) (apply #'+ epoque-result))    (cond ((or (<= (/ (apply #'+ epoque-result) (length stimuli)) error)               (>= (epoch ann) *max-stop-epoch*)               (>= (epoch ann) stop))           (format t "~%>> End of training at epoch ~S with ~S errors (~S %).~%" (epoch ann) (apply #'+ epoque-result)                   (float (* 100 (/ (apply #'+ epoque-result) (length stimuli)))))           (values))          (t           (push (apply #'+ epoque-result) *history-error*)           (incf (epoch ann))           (train-percep stimuli goals net s-res                          :func func                         :thresh thresh                         :learn learn                         :error error                         :stop stop                         :verbose verbose                         :slope slope)))))(defmethod train-perceptron ((stimuli list) (goals list) (net array)                             &key                             (temp 0.0)                             (learn .75)                              (func #'logistic)                             (slope 1)                             (error 0)                             (thresh 0)                             (stop 1000)                             (verbose t))  (train-percep stimuli goals net '()                 :thresh thresh :temp temp :learn learn :func func :error error                :stop stop :verbose verbose :slope slope))(defmethod train-perceptron ((stimuli list) (goals list) (net symbol)                             &key                             (temp 0.0)                             (learn .75)                              (func #'logistic)                             (slope 1)                             (error 0)                             (thresh 0)                             (stop 1000)                             (verbose t))    (train-percep stimuli goals (net (eval net)) '()                 :thresh thresh                 :temp temp                 :learn learn                 :func func  :slope slope                :error error                 :stop stop :verbose verbose))(defmethod train-perceptron ((stimuli list) (goals list) (net perceptron)                             &key                             (temp 0.0)                             (learn .75)                              (func #'logistic)                             (slope 1)                             (error 0)                             (thresh 0)                             (stop 1000)                             (verbose t))  (train-percep stimuli goals net '()                :thresh thresh :temp temp :learn learn :func func :error error                :stop stop :verbose verbose :slope slope))(defmethod train-perceptron ((stimuli list) (goals list) (net array)                             &key                             (temp 0)                             (learn .75)                              (func #'logistic)                             (slope 1)                             (error 0)                             (thresh 0)                             (stop 1000)                             (verbose t))  (train-percep stimuli goals net '()                 :thresh thresh :temp temp :learn learn :func func :error error                :stop stop :verbose verbose :slope slope))(defmethod learn ((net perceptron) (stimuli t) (goals t)                   &key (learn .75) (temp .0) (thresh .0) (slope 1.0) (out-func #'logistic) (input-func nil) (hidden-func #'logistic)                  (func #'binary) (error .0)  (stop 1000) (verbose 'nil))  (declare (ignore input-func out-func hidden-func))  (format t "~%> Training perceptron ~S." (name net))  (format t "~%Learning slope = ~D, learn = ~D, temperature = ~D, function ~S, threshold = ~D..."          slope learn temp (function-name func) thresh)  (setf (previous net) (copy-net (net net)))  (train-perceptron stimuli goals net                    :learn learn                     :temp temp                    :thresh thresh                    :func func                    :slope slope                    :error error                    :start (epoch net)                    :stop (+ (epoch net) stop)                    :verbose verbose))#|(defmethod start-learning ((ann ann))   (setf *history-error* '())   (setf *current-epoch* 0))|#(defmethod clear ((ann perceptron))  (setf (net ann)        (init-perceptron (array-dimension (net ann) 0)                         (array-dimension (net ann) 1))        (creation-date ann) (get-time)        (modification-date ann) 'nil        (history ann) nil        (epoch ann) 0)  (format t "~%Perceptron ~S cleared.~%" (name ann))  (values))(defmethod clear ((ann symbol))  (setf ann (eval ann))  (clear ann))(defmethod save ((ann perceptron) &optional file)  (let ((data (net ann))        (file (if file file (choose-new-file-dialog))))    (with-open-file (out file                         :direction :output                         :if-exists :supersede)      (format out "(setf ~S (make-instance 'perceptron~%" (name ann))      (format out ":name (quote ~S)~%" (name ann))      (format out ":in-size ~S~%" (array-dimension (net ann) 0))      (format out ":out-size ~S~%" (array-dimension (net ann) 1))      (format out ":net ~S~%" data)      (format out ":creation-date '~S~%" (creation-date ann))      (format out ":modification-date ~S~%" (modification-date ann))      (format out "))~%")      (format out "(print ~S)~%" (name ann))      (format t "Perceptron ~S saved into file ~S.~%" (name ann) file)      )))(defmethod save ((ann symbol) &optional file)  (save (eval ann) file))(defmethod save ((ann array) &optional file)  (let ( (file (if file file (choose-new-file-dialog))))    (with-open-file (out file                         :direction :output                         :if-exists :supersede)      (format out "~%#2a(~%")      (dotimes (i (array-dimension ann 0))        (format out "(")        (dotimes (j (array-dimension ann 1) (format out ")~%"))          (format out "~D " (aref ann i j))))      (format out ")~%"))    (format t "Matrix ~S saved into file ~S.~%" ann file)    ));;*****************************************************************;;;;;                      MLP & BACKPROPAGATION;;*****************************************************************(defmethod init-mlp ((in-size integer) (out-size integer) &rest hidden-layers)  "initialisation random d'un perceptron multicouches."  (let ((hidden (list)))    (dotimes (n (1+ (length hidden-layers)))      (push (cond ((= 0 n)                   (make-array (list (car hidden-layers) in-size)))                  ((= (length hidden-layers) n)                   (make-array (list out-size (car (last hidden-layers)))))                  (t                   (make-array (list (nth n hidden-layers)                                     (array-dimension (car hidden) 0)                                     ))))            hidden))    (dolist (h hidden)      (dotimes (i (array-dimension h 0))        (dotimes (j (array-dimension h 1))          (setf (aref h i j) (- .2 (random 0.4))))))    (reverse hidden)))#|(init-mlp 3 3 2 2)|#(defun output-signal-error (theorical-output actual-output)  (assert (= (length theorical-output) (length actual-output)))  (multiply-two-vectors   (substract-two-vectors    (apply #'vector (make-list (length actual-output) :initial-element 1))    actual-output)   (multiply-two-vectors    (substract-two-vectors theorical-output actual-output)    actual-output)))(defun error-retropopagation (output-layer output-signal-error)  (let ((dd (make-array (list (nth 0 (array-dimensions output-layer))                              (nth 1 (array-dimensions output-layer))))))    (dotimes (i (nth 0 (array-dimensions output-layer)))      (dotimes (j (nth 1 (array-dimensions output-layer)))        (setf (aref dd i j) (aref output-signal-error i)              (aref dd i j) (aref output-signal-error i))))    (hadamar-product output-layer dd)))(defun update-output-weights (output-layer hidden-answer output-signal-error n &optional clip)  (let ((DZ (make-array (list (nth 0 (array-dimensions output-layer))                              (nth 1 (array-dimensions output-layer))))))    (dotimes (i (length output-signal-error))      (dotimes (j (length hidden-answer))        (setf (aref DZ i j) (* (aref output-signal-error i)                               (aref hidden-answer j)                               n))))    (add-two-matrices     output-layer     DZ :clip clip)))(defun hidden-error-estimation (error-retropopagation)  (let ((f '()))    (dotimes (i (nth 1 (array-dimensions error-retropopagation)) (apply #'vector (reverse f)))      (let ((temp 0))        (dotimes (j (nth 0 (array-dimensions error-retropopagation)) (push temp f))          (setf temp (+ temp (aref error-retropopagation j i))))))))(defun hidden-signal-error (hidden-activation hidden-error-estimation)  (assert (= (length hidden-activation) (length hidden-error-estimation)))  (multiply-two-vectors   (substract-two-vectors    (apply #'vector (make-list (length hidden-activation) :initial-element 1))    hidden-activation)   (multiply-two-vectors    hidden-error-estimation    hidden-activation)))(defun update-hidden-weights (hidden-layer input hidden-signal-error n &optional clip)  (let ((DW (make-array (list (nth 0 (array-dimensions hidden-layer))                              (nth 1 (array-dimensions hidden-layer))))))    (dotimes (i (length hidden-signal-error))      (dotimes (j (length input))        (setf (aref DW i j) (* (aref hidden-signal-error i)                               (aref input j)                               n))))    (add-two-matrices     hidden-layer     DW :clip clip)))(defmethod backpropagate ((mlp mlp) (input vector) (output vector)                           &key (learn 1.0) (error 0) (temp 0) (slope 1.0)                          (hidden-func #'logistic) (out-func #'logistic)                          (thresh 0) (clip nil))  (let ((hidden-answer-cell (list))        output-answer-cell        out-signal-error        (hidden-signal-error (list))        (e 1000))    (dotimes (down (- (length (net mlp)) 1))  ;; 1- activation = top->down      (if (zerop down)        (push (funcall hidden-func (multiply-matrix-and-vector (car (net mlp)) input)                       :temp temp                       :slope slope                       :thresh thresh)              hidden-answer-cell)        (push (funcall hidden-func (multiply-matrix-and-vector (nth down (net mlp)) (car hidden-answer-cell))  ;(nth (1- down) hidden-answer-cell)                       :temp temp                       :slope slope                       :thresh thresh)              hidden-answer-cell)))    (setf output-answer-cell (funcall out-func (multiply-matrix-and-vector (car (last (net mlp))) (car hidden-answer-cell))                                      :temp temp                                      :slope slope                                      :thresh thresh)          out-signal-error (output-signal-error output output-answer-cell)          e (apply #'+ (check-error output-answer-cell output error)))    (if (< e error)      (progn ()             (format t "~% Error reached : no backpropagation.")             (values mlp e))      (progn ()             (dotimes (up (length hidden-answer-cell))  ;; 2- signal error = bottom->up               (if (zerop up)                 (push (hidden-signal-error (car hidden-answer-cell)                                            (hidden-error-estimation                                             (error-retropopagation (car (last (net mlp))) out-signal-error)))                       hidden-signal-error)                 (push (hidden-signal-error (nth up hidden-answer-cell)                                            (hidden-error-estimation                                             (error-retropopagation (nth (- (length (net mlp)) up 1)  (net mlp))                                                                    (car hidden-signal-error)))) ;(nth (- up 1)                       hidden-signal-error)))             (setf hidden-answer-cell (reverse hidden-answer-cell))             (dotimes (down (length hidden-signal-error))  ;;3- update = top->down               (if (zerop down)                 (setf (car (net mlp)) (update-hidden-weights (car (net mlp)) input                                                              (car hidden-signal-error) learn clip))                 (setf (nth down (net mlp)) (update-hidden-weights (nth down (net mlp)) (nth (- down 1) hidden-answer-cell)                                                                   (nth down hidden-signal-error) learn clip))))             (setf (car (last (net mlp))) (update-output-weights (car (last (net mlp))) (car (last hidden-answer-cell))                                                                 out-signal-error learn clip))             (values mlp e)))))(defmethod learn ((ann mlp) (input vector) (goal vector)                   &key                  (temp 0) (learn 1.0) (slope 1.0)                  (input-func nil)                  (hidden-func #'logistic)                  (out-func #'logistic) (clip nil)                  (thresh 0) (error 0.001) (stop *max-stop-epoch*) (method nil) (verbose nil) (view nil))  (setf (previous ann) (copy-net ann))  ; backup of previous state  (multiple-value-bind (mlp e)                       (backpropagate ann (if input-func                                             (funcall input-func input)                                            input) goal                                      :learn learn :error error :temp temp :slope slope :clip clip                                      :hidden-func hidden-func :out-func out-func :thresh thresh)        (push e (history-error ann))    (incf (epoch ann))    (cond ((or (<= e error)               (>= (epoch ann) stop)               (>= (epoch ann) *max-stop-epoch*))           (when verbose (format t "~%> Learning at epoch ~D with ~D errors." (epoch ann) e))           mlp)          (t (learn mlp input goal                    :learn learn :error error :temp temp :slope slope                    :hidden-func hidden-func :out-func out-func :thresh thresh :stop stop                    :method method :verbose verbose :view view)))))(defmethod learn ((ann mlp) (input list) (goal list)                   &key                  (temp 0) (learn 1.0) (slope 1.0)                  (input-func nil)                  (hidden-func #'logistic) (out-func #'logistic) (clip nil)                  (thresh 0) (error 0.001) (stop *max-stop-epoch*) (method 'random) (verbose nil))  (setf (previous ann) (copy-net ann))  ;-> backup of previous state  (let ((temp-error '())        (learn-view (find-window (concatenate 'string "Learning for " (string (name ann))) 'learn-window))        (net-view (find-window (concatenate 'string "Net of " (string (name ann))) 'net-window))        max)    (cond ((equal 'sequence method)           (dotimes (n (length input))             (multiple-value-bind (mlp e)                                  (backpropagate ann (if input-func                                                        (funcall input-func (nth n input))                                                       (nth n input))                                                 (nth n goal)                                                 :learn learn :error error :temp temp :slope slope :clip clip                                                 :hidden-func hidden-func :out-func out-func :thresh thresh)               (push e temp-error)               (sleep *pause*)               (when learn-view                 (ccl::thermometer-update-values-2 (view-named 'error-th learn-view) (scale-th-error (* e e))))               (values mlp)))           (setf (current-error ann) (car (history-error ann)))           (push (float (/ (apply #'+ (mapcar #'(lambda (x) (* x x)) temp-error)) (in-size ann))) (history-error ann))           (setf (epoch ann) (incf (epoch ann))                 max (if (car (last-stop ann)) (+ (car (last-stop ann)) stop) stop))           (when learn-view             (ccl::thermometer-update-values-2 (view-named 'mean-th learn-view) (let ((lerror (scale-th-error (car (history-error ann)))))                                                                                  (list lerror                                                                                        (- (scale-th-error (last-error ann)) lerror))                                                                                  ))             (ccl::thermometer-update-values-2 (view-named 'epoch-th learn-view) (round (* 100 (- (epoch ann)                                                                                                  (car (last-stop ann))))                                                                                        stop )))           )          ((equal 'random method)           (let ((r (random (length input)))                 (temp-error '()))             (dotimes (n (length input))               (multiple-value-bind (mlp e)                                    (backpropagate ann (nth r input) (nth r goal)                                                   :learn learn :error error :temp temp :clip clip                                                   :hidden-func hidden-func :out-func out-func :thresh thresh)                 (push e temp-error)                 (when learn-view                   (ccl::thermometer-update-values-2 (view-named 'error-th learn-view) (scale-th-error (* e e))))                 (sleep *pause*)                 (when learn-view                   (ccl::thermometer-update-values-2 (view-named 'error-th learn-view) (scale-th-error (* e e))))                 (values mlp)))             (setf (current-error ann) (car (history-error ann)))             (push (float (/ (apply #'+ (mapcar #'(lambda (x) (* x x)) temp-error)) (in-size ann))) (history-error ann))             (setf (epoch ann) (incf (epoch ann))                   max (if (car (last-stop ann)) (+ (car (last-stop ann)) stop) stop))             (when learn-view               (ccl::thermometer-update-values-2 (view-named 'mean-th learn-view) (let ((lerror (scale-th-error (car (history-error ann)))))                                                                                    (list lerror                                                                                          (- (scale-th-error (last-error ann)) lerror))                                                                       