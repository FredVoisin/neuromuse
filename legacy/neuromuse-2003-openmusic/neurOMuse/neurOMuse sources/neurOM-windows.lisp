        (dotimes (j (+ (length seq2) 1))           (dotimes (i (+ (length seq1) 1))               (setf d (+ i (* j (+ (length seq1) 1))))               ;--- SI i et j differents de 0 => cas d'un changement ---               (cond ((and (> i 0) (> j 0))                           ;;calcul du cout                           (if (funcall test (nth (- i 1) seq1) (nth (- j 1) seq2))                              (setf c1 0)                              (setf c1 rep ;(if (member (nth (- i 1) seq1) seq2)                                       ;rep (* 2 rep))                                       rep (+ (* rep fact) rep)))                           ;;calcul de D(i,j)                           (setf d1 (nth (+ 1 (length seq1)) matcouts)                                    d2 (nth (length seq1) matcouts)                                    d3 (nth 0 matcouts))                           ;;calcul de cout mini                           (setf c (funcall #'min (+ c1 d1) (+ 1 d2) (+ 1 d3)))                           (push c matcouts))                          ;--- SI i ou j = 0  => cas d'une suppression ou insertion                           ;   (= changement par element neutre) ---                          (t                            ;;calcul du cout                            (if (and (= i 0) (= j 0))                               (setf c1 0)                               (setf c1 ins                                        ins (+ ins (* fact insert))))                            ;;si i = 0 et j> 0                            (cond ((and (eq i 0) (> j 0))                                        ;calcul de D(i,j)                                        (setf d (nth (length seq1) matcouts))                                        (setf c (+ c1 d))                                        (push c matcouts))                                       ;;si i > 0 et j = 0                                       ((and (> i 0) (= j 0))                                         ;calcul de D(i,j)                                         (setf d (nth 0 matcouts))                                         (setf c (+ c1 d))                                         (push c matcouts))                                       (t (push '0 matcouts) (setf c '0)))))))       (if scale          (float (/ (car matcouts) (length seq1)))          (car matcouts))))(defmethod editing-distance ((seq1 string) (seq2 string) (replace number) (insert number)                                                   &key (test #'equalp) (scale nil) (fact 1))    (editing-distance (characters seq1) (characters seq2) replace insert                                 :test test :scale scale :fact fact))(defun characters (string)  (let ((c '()))    (dotimes (n (length string) (reverse c))      (push (elt string n) c))))(defun seq-member (s1 s2)  (let ((a nil) (l1 (length s1)) (l2 (length s2)))    (loop for s from 0 to (1- l2)          until (setf a (equalp s1                                (subseq s2 s                                        (funcall #'min l2 (+ s l1)))))          finally (return a))))(defun search-ann (&optional name &key test)  (let ((anns '()))    (if test      (do-symbols (sym nil)        (when (boundp sym)          (when (and (ann-p (eval sym))                     (funcall test (eval sym)))            (push sym anns))))      (do-symbols (sym nil)        (when (boundp sym)          (when (ann-p (eval sym))            (push sym anns)))))    (if name      (let ((n (characters (string name))))        (loop for i from 0 to (1- (length anns))              do              (if (seq-member n (characters (string (nth i anns))))                (setf (nth i anns) (list 0 (nth i anns)))                (setf (nth i anns) (list (editing-distance                                          (characters (string (nth i anns)))                                          n                                           1.2 1 :test #'char-equal :scale t :fact 0)                                         (nth i anns)))))        (sort anns '< :key #'first))      (sort anns            #'string-lessp ))));;***********************;;*** DEFINE ANN WINDOWS ****;;***********************(defclass define-ann-dialog-item (color-dialog)  (   ;(type :initarg :type :accessor type :initform 'perceptron)   )  )(defclass ann-dialog-item ()  ()  )(defun define-ann-dialog ()  (MAKE-INSTANCE    'define-ann-dialog-item    :TYPE 'Perceptron    :WINDOW-TYPE    :DOCUMENT    :WINDOW-TITLE    "Define a new ANN"    :VIEW-POSITION    #@(311 42)    :VIEW-SIZE    #@(300 130)    :VIEW-FONT    '("Chicago" 12 :SRCOR :PLAIN (:COLOR-INDEX 0))    :VIEW-SUBVIEWS    (LIST (MAKE-INSTANCE            'POP-UP-MENU            :VIEW-POSITION            #@(52 20)            :VIEW-SIZE            #@(196 20)            :MENU-TITLE            "Type"            :MENU-ITEMS            (LIST (MAKE-INSTANCE                    'MENU-ITEM                    :MENU-ITEM-TITLE                    "simple perceptron"                    :MENU-ITEM-ACTION                    #'(LAMBDA NIL (let ((view (front-window :class 'define-ann-dialog-item)))                                    (setf (type view) 'perceptron)                                    (make-dialog-views view)))                    :STYLE 'NIL                    :MENU-ITEM-CHECKED                    #\CheckMark)                  (MAKE-INSTANCE                    'MENU-ITEM                    :MENU-ITEM-TITLE                    "MLP"                    :MENU-ITEM-ACTION                    #'(LAMBDA NIL (let ((view (front-window :class 'define-ann-dialog-item)))                                    (setf (type view) 'MLP)                                    (make-dialog-views view)))                    :STYLE                    'NIL)                  (MAKE-INSTANCE                    'MENU-ITEM                    :MENU-ITEM-TITLE            