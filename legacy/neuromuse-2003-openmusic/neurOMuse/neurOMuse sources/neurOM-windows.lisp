0    :reader scalex    :accessor scalex    :type number)   (scaley    :initarg :scaley    :initform 1.0    :reader scaley    :accessor scaley    :type number)   (legend    :initarg :legend    :initform '("x")    :reader legend    :accessor legend    :type list)      )  (:documentation "trace window 2 dim.")  )(defmethod view-draw-contents ((self trace-window))  (call-next-method)    (let ((data (data self))        (scalex (scalex self))        (scaley (scaley self)))    (if (member 't (mapcar #'listp data))      (dolist (d data)        (trace-pt self d scalex scaley))      (trace-pt self data scalex scaley))    ))(defun trace-pt (self data scalex scaley)  (let ((miny  0)) ;(apply #'min data)))    (dotimes (i (length data))      (if (= 0 i)         (move-to self 25 (round (* scaley (- (car data) miny))))        (line-to self                  (+ 25 (round (* scalex i)))                 (+ 25 (round (* scaley (- (nth i data) miny)))))        ))))(defun make-trace-window (data scalex scaley legend)    (make-instance 'trace-window    :data data    :scalex scalex    :scaley scaley    :legend legend    :window-title legend    :scroller-class 'scroller    :window-type :document-with-zoom    :view-size #@(200 300)    :track-thumb-p t))#|(make-trace-window (list (subseq *history-error* 0 6000)) .1 100.0 '("1"))|#(defun dark-p (color)  (multiple-value-bind (a b c)                       (color-values color)    (if (and (< a 25000) (< b 25000) (< c 25000))      t nil)))(defclass color-window (window)  ((color :initform *blue-color* :accessor color :initarg :color))  (:default-initargs    :color-p t    :window-title ""         :window-show nil    :close-box-p t))(defclass main-ann-window (color-window)  ((ann :initform nil :accessor ann :initarg :ann)   )  (:default-initargs    :view-size #@(400 170)    :back-color *black-color*    :window-type :document)  (:documentation "Class of ann windows"))(defmethod corner-position (button)  (let ((margin #@(25 5)))    (subtract-points (view-size (view-container button))                     (add-points margin (view-size button)))))(defmethod initialize-instance :after ((self main-ann-window)                                       &key ann)  (when (not (color ann)) (setf (color ann) *black-color*))  (let ((name (make-instance 'static-text-dialog-item                 :view-position #@(160 10)                :view-font '("Monaco" 14 :bold)                :view-size (make-point (string-width (format nil "ann ~S ~S " (type-of ann) (string (name ann)))                                                     '("Monaco" 14 :bold)) 16)                :dialog-item-text (format nil "ANN ~S ~S"                                          (type-of ann) (string (name ann)))))        (ncells (make-instance 'static-text-dialog-item                   :view-position #@(20 30)                   :view-size #@(100 16)                  :view-nick-name 'ncells                  :dialog-item-text (format nil "~S neurones"                                             (apply #'+ (ann-structure ann)))))        (input (make-instance 'static-text-dialog-item                  :view-position #@(20 50)                  :view-size #@(150 16)                 ::view-nick-name 'input                 :dialog-item-text (format nil "input layer : ~S cells"                                            (car (ann-structure ann)))))        (output (make-instance 'static-text-dialog-item                   :view-position #@(20 70)                   :view-size #@(150 16)                  :view-nick-name 'output                  :dialog-item-text (format nil "output layer : ~S cells"                                             (car (last (ann-structure ann))))))        (structure (make-instance 'static-text-dialog-item                      :view-position #@(20 90)                      :view-size #@(150 16)                     :view-nick-name 'structure                     :dialog-item-text (format nil "Structure : ~S" (ann-structure ann))))        (net-button (make-instance 'button-dialog-item                      :view-position #@(20 125)                      :view-nick-name 'bet-button                      :dialog-item-text "net"                      :dialog-item-action                      #'(lambda (button)                          (window-select                           (make-instance 'net-window                             :ann (ann (view-container button)))                           ))))        (learn-button (make-instance 'button-dialog-item                        :view-position #@(220 125)                        :view-nick-name 'learn-button                        :dialog-item-text "Learn"                        :dialog-item-action                        #'(lambda (button)                            (window-select                             (make-instance 'learn-window                               :ann (ann (view-container button)))                             ))))        (color-button (make-instance 'button-dialog-item                        :view-position #@(6 6)                        :view-size #@(10 12)                        :dialog-item-text "c"                        :view-font '("Geneva" 9 :PLAIN)                        :border-p nil                        :dialog-item-action #'(lambda (x)                                                (declare (ignore x))                                                (let ((color (user-pick-color :color (color self))))                                                  (setf (color (ann self)) color)                                                  (set-back-color self color)                                                  (do-subviews (subview self)                                                    (when (typep subview 'static-text-dialog-item)                                                      (if (dark-p color)                                                        (set-part-color subview :text *white-color*)                                                        (set-part-color subview :text *black-color*)))                                                    )                                                  ))))        )    (add-subviews self       name ncells input output structure      net-button learn-button color-button      )    (set-back-color self (color (ann self)))    (do-subviews (subview self)      (when (typep subview 'static-text-dialog-item)        (if (dark-p (color (ann self)))          (set-part-color subview :text *white-color*)          (set-part-color subview :text *black-color*)))      )    (set-window-title self (name ann))    (window-select self)    ))(defmethod view-draw-contents ((self main-ann-window))  (call-next-method)  )(defmethod window-show ((self symbol))  (window-show (eval self)))#|(defmethod window-show ((self ann))  (window-select (window self)))|#(defclass learn-window (color-window)  ((ann :initform nil :accessor ann :initarg :ann)   (current-input :initform nil :accessor current-input :initarg :current-input)   (current-output :initform nil :accessor current-output :initarg :current-output)   )  (:default-initargs    :back-color *white-color*    :window-type :document    :view-size #@(440 285))  (:documentation "Class of learn monitor windows"))(defmethod initialize-instance :after ((self learn-window) &key ann)  (when (> (color (ann self)) 0) (set-back-color self (color (ann self))))  (let ((comment (make-instance 'static-text-dialog-item                    :view-position #@(20 50)                    :view-size #@(330 16)                   :view-nick-name 'learn-comment                   :dialog-item-text (format nil "  Last learning stopped at epoch ~D"                                             (epoch ann))))                              (error-button (make-instance 'button-dialog-item                        :view-position #@(20 20)                        :view-size #@(120 20)                        :view-nick-name 'error-button                        :dialog-item-text "Error view"                        :dialog-item-action                        #'(lambda (button)                            (window-select                             (make-instance 'main-error-window                               :ann (ann (view-container button)))))))        (leg1 (make-instance 'static-text-dialog-item                 :view-position #@(140 105)                 :view-size #@(145 15)                :dialog-item-text "Learning Progress"))        (epoch-th (make-instance 'ccl::thermometer                    :direction :horizontal                    :value (list 0 0)                    :length 300                    :pattern (wpatterns)                    :view-nick-name 'epoch-th                    :view-position #@(50 120)))        (leg2 (make-instance 'static-text-dialog-item                 :view-position #@(140 155)                 :view-size #@(140 15)                :dialog-item-text "Epoch Mean Error"))        (error-th (make-instance 'ccl::thermometer                    :direction :horizontal                    :length 300                    :max-value 200                    :pattern (wpatterns)                    :view-nick-name 'error-th                    :view-position #@(50 170)))        (leg3 (make-instance 'static-text-dialog-item                 :view-position #@(150 205)                 :view-size #@(100 15)                :dialog-item-text "Sample Error"))        (mean-th (make-instance 'ccl::thermometer                   :direction :horizontal                   :max-value 200                   :length 300                   :pattern (wpatterns)                   :view-nick-name 'mean-th                   :view-position #@(50 220)))        (start-button (make-instance 'button-dialog-item                        :view-position #@(160 20)                        :view-size #@(120 20)                        :view-nick-name 'close-button                        :dialog-item-text "Start learning"                        :dialog-item-action                        #'(lambda (button)                            (start-learning (ann (view-container button)) button)                            )))        (pause-button (make-instance 'button-dialog-item                        :view-position #@(300 20)                        :view-size #@(120 20)                        :view-nick-name 'close-button                        :dialog-item-text "Break"                        :dialog-item-action                        #'(lambda (button)                            (pause-learning (ann (view-container button)) button))))        )    (add-subviews self       comment  error-button  start-button pause-button      leg1 leg2 leg3      epoch-th error-th mean-th)    (set-window-title self (concatenate 'string "Learning for " (string (name ann))))    ))(defun start-learning (ann &optional button)  (when button    (set-dialog-item-text button "Stop learning")    (set-PART-COLOR button :FRAME 15406345)    (set-PART-COLOR button :TEXT 15406345))  ann)(defun pause-learning (ann &optional button)  (when button    (set-dialog-item-text button "Resume")    (set-PART-COLOR button :FRAME 15406345)    (set-PART-COLOR button :TEXT 15406345))  ann)(defun wpatterns ()  (list *black-pattern* *gray-pattern*))(defun make-scale-menu (view &optional (h 0) (v 0))  (make-instance 'pull-down-menu    :view-position (make-point h v)    :view-size  #@(60 20)    :menu-title ""    :auto-update-default  t    :item-display :selection    :default-item 1    :menu-items    (list (make-instance 'menu-item            :menu-item-title "lin"            :menu-item-action #'(lambda ()                                  (setf (slot-value view 'scale-fct) #'(lambda (x) x))                                  (invalidate-view view t)                                  ))          (make-instance 'menu-item            :menu-item-title "log10"            :menu-item-action #'(lambda ()                                  (setf (slot-value view 'scale-fct) #'(lambda (x) (log (1+ x) 10)))                                  (invalidate-view view t)                                  ))          (make-instance 'menu-item            :menu-item-title "log20"            :menu-item-action #'(lambda ()                                  (setf (slot-value view 'scale-fct) #'(lambda (x) (log (1+ x) 20)))                                  (invalidate-view view t)                                  ))          (make-instance 'menu-item            :menu-item-title "log100"            :menu-item-action #'(lambda ()                                  (setf (slot-value view 'scale-fct) #'(lambda (x) (log (1+ x) 100)))                                  (invalidate-view view t)                                  )))))(defun make-samplingrate-menu (view &optional (h 0) (v 0))  (make-instance 'pull-down-menu    :view-position (make-point h v)    :view-size  #@(80 20)    :menu-title ""    :auto-update-default  t    :item-display :selection    :default-item 1    :menu-items    (list (make-instance 'menu-item            :menu-item-title "sr = 1"            :menu-item-action #'(lambda ()                                  (setf (slot-value view 'sampling-rate) 1.0)                                  (invalidate-view view t)                                  ))          (make-instance 'menu-item            :menu-item-title "sr = 1/2"            :menu-item-action #'(lambda ()                                  (setf (slot-value view 'sampling-rate) 2)                                  (invalidate-view view t)                                  ))          (make-instance 'menu-item            :menu-item-title "sr = 1/3"            :menu-item-action #'(lambda ()                                  (setf (slot-value view 'sampling-rate) 3)                                  (invalidate-view view t)                                  ))          (make-instance 'menu-item            :menu-item-title "sr = 1/4"            :menu-item-action #'(lambda ()                                  (setf (slot-value view 'sampling-rate) 4)                                  (invalidate-view view t)                                  ))          (make-instance 'menu-item            :menu-item-title "sr = 1/10"            :menu-item-action #'(lambda ()                                  (setf (slot-value view 'sampling-rate) 10)                                  (invalidate-view view t)                                  )))))(defclass main-error-window (color-window)  ((ann :initform nil :accessor ann :initarg :ann)   (zoom-in-button :initform nil :accessor zoom-in-button :initarg :zoom-in-button)   (zoom-out-button :initform nil :accessor zoom-out-button :initarg :zoom-out-button)   (scale-fct-button :initform nil :accessor scale-fct-button :initarg :scale-fct-button)   (scale-fct :initform #'(lambda (x) x) :accessor scale-fct :initarg :scale-fct)   (x-axis :initform nil :accessor x-axis :initarg :x-axis)   (y-axis :initform nil :accessor y-axis :initarg :y-axis)   (xzoom-fact :initform 1.0 :accessor xzoom-fact :initarg :xzoom-fact)   (yzoom-fact :initform 1.0 :accessor yzoom-fact :initarg :yzoom-fact)   (sampling-rate-button :initform nil :accessor sampling-rate-button :initarg :sampling-rate-button)   (sampling-rate :initform 1.0 :accessor sampling-rate :initarg :sampling-rate)   (x-legend :initform nil :accessor x-legend :initarg :x-legend)   )  (:default-initargs    :view-size #@(600 350)    :back-color *white-color*    :window-type :document-with-zoom)  )(defmethod initialize-instance :after ((self main-error-window) &key)  (let ((view-size (view-size self))        )    (set-window-title self (concatenate 'string "Error history for "                                         (if (ann self) (string (name (ann self))) nil)))    (setf (slot-value self 'x-legend)          (make-instance 'static-text-dialog-item             :view-position (make-point (round (point-h view-size) 2) (- (point-v view-size) 20) )            :view-size #@(40 15)            :view-font '("Geneva" 9)            :dialog-item-text "epochs")          (slot-value self 'zoom-in-button)          (make-instance 'button-dialog-item            :view-size #@(50 14)            :view-nick-name 'zoom-in-button            :dialog-item-text "Xzoom in"            :view-font '("Geneva" 9 :Plain)            :dialog-item-action            #'(lambda (button)                (declare (ignore button))                (setf (xzoom-fact self) (* 1.5 (xzoom-fact self)))                (invalidate-view self t)                ;(view-draw-contents (x-axis self))                ))          (slot-value self 'zoom-out-button)          (make-instance 'button-dialog-item            :view-size #@(50 14)            :view-nick-name 'zoom-out-button            :dialog-item-text "Xzoom out"            :view-font '("Geneva" 9 :Plain)            :dialog-item-action            #'(lambda (button)                (declare (ignore button))                (setf (xzoom-fact self) (* .75 (xzoom-fact self)))                (invalidate-view self t)                ;(view-draw-contents (x-axis self))                ))          (slot-value self 'scale-fct-button)          (make-scale-menu self)          (slot-value self 'sampling-rate-button)          (make-samplingrate-menu self)          (slot-value self 'x-axis)          (make-instance 'axis-view            :axis-length (- (point-h view-size) 50)            :orientation :horizontal)          (slot-value self 'y-axis)          (make-instance 'axis-view            :axis-length (- (point-v view-size) 50)            :orientation :vertical))    (add-subviews self       (zoom-in-button self) (zoom-out-button self)      (scale-fct-button self) (x-axis self) (y-axis self) (sampling-rate-button self) (x-legend self))    (set-view-position (zoom-in-button self) (+ 300 (view-left self)) 12)    (set-view-position (zoom-out-button self) (+ 370 (view-left self)) 12)    (set-view-position (scale-fct-button self) (+ 130 (view-left self)) 35)    (set-view-position (sampling-rate-button self) (+ 50 (view-left self)) 35)    (set-view-position (x-axis self) (- (point-h view-size) (point-h view-size) -52)                       (- (point-v view-size) 40))    (set-view-position (y-axis self) (- (point-h view-size) (point-h view-size) -50)                       (- (point-v view-size) (point-v view-size) -10))    (adjust-sampling-rate self)    (window-select self)))(defmethod view-draw-contents ((self main-error-window))  (call-next-method)  (let ((center (round (view-width self) 2)))    (set-view-position (zoom-in-button self) (- center 50)  12)    (set-view-position (zoom-out-button self) (+ center 10) 12)    (set-view-position (scale-fct-button self) (- center 50) 35)    (set-view-position (sampling-rate-button self) (+ center 10) 35)    (set-view-size (x-axis self) (- (view-width self) 45) (tick-length (x-axis self)) )    (set-view-position (x-axis self) 25 (- (view-height self) 40 (- (tick-length (x-axis self))) ))    (set-view-size (y-axis self) (tick-length (y-axis self)) (- (view-height self) 40 ))    (set-view-position (y-axis self) (- 25 (tick-length (y-axis self))) 5) ;15    (trace-error self (mapcar (scale-fct self) (resample (history-error (ann self)) (sampling-rate self))))    (view-draw-contents (x-axis self))    (set-view-position (x-legend self) (round (view-width self) 2) (- (view-height self) 20))    ))(defmethod window-grow-event-handler ((self main-error-window) where)  (declare (ignore where))  (call-next-method)  (invalidate-view self)  )(defmethod set-view-size ((self main-error-window) h &optional v)  (declare (ignore h v))  (call-next-method)  (invalidate-view self t))(defmethod trace-error ((self view) (data list))  (let ((max (apply #'max data))        (length (length data))        (hsize (view-width self))        (vsize (view-height self))        xz)    (setf xz (/ (- hsize 45) length)          (tick-spacing (x-axis self)) (round (* (xzoom-fact self) xz 100))          (tick-spacing (y-axis self)) (round (* (yzoom-fact self) (/ (- vsize 40) max) 1)))    (ccl::move-to self 25 (- vsize 35))    (dotimes (i (length data))      (ccl::line-to self                     (round (+ 25 (* (xzoom-fact self) xz i)))                    (round (* (- vsize 40) (/ (- max (nth (- length i 1) data)) max)))))    ))(defmethod trace-error ((self view) (data null))  (declare (ignore sampling-rate))  (warning "history error is empty"))(defun resample (data sr)  (if (= 1 sr)    data    (loop for i from 0          until (> (round (* i sr)) (1- (length data)))          collect (nth (round (* i sr)) data))))(defun adjust-sampling-rate (error-view)  (let ((data-length (length (history-error (ann error-view)))))    (setf (sampling-rate error-view)          (floor (1+ (/ data-length 4000))))))(defclass axis-view (simple-view)  ((orientation :initarg :orientation :accessor orientation :initform :vertical)   (axis-length :initarg :axis-length :accessor axis-length :initform 100)   (tick-length :initarg :tick-length :accessor tick-length :initform 5)   (tick-spacing :initarg :tick-spacing :accessor tick-spacing :initform 10)   ))(defmethod initialize-instance :after ((self axis-view) &rest initargs)  (declare (ignore initargs))  (if (equal (orientation self) :vertical)    (set-view-size self (make-point (tick-length self) (1+ (axis-length self))))    (set-view-size self (make-point (axis-length self) (tick-length self)))))(defmethod view-draw-contents ((self axis-view) &aux (x 0) l)  (cond ((equal (orientation self) :vertical)         (erase-rect self 0 0 (view-width self) (view-height self))         (view-draw-vertical-line self (view-width self))         (setf l (view-height self) ;(+ (view-height self) 1)               )         (loop           (view-draw-horizontal-line self l)           (incf l (- (tick-spacing self)))           (if (<= l 0) (return nil))))        (t         (erase-rect self 0 0 (view-width self) (view-height self))         (view-draw-horizontal-line self 0);(round (view-height self) 2))         (setf l (view-width (view-container self))) ;(+ (view-width self) 1))         (loop           (view-draw-vertical-line self x)           (incf x (tick-spacing self))           (if (>= x l) (return nil))))))(defun view-width (view)  (point-h (view-size view)))(defun view-height (view)  (point-v (view-size view)))(defun view-right (view)  (+ (point-h (view-position view))     (point-h (view-size view))))(defun view-left (view)  (point-h (view-position view)))(defun view-bottom (view)  (+ (point-v (view-position view))     (point-v (view-size view))))(defun view-top (view)  (point-v (view-position view)))(defun middle-left (self)  (let ((dp (view-position self)) (s (view-size self)))    (make-point (point-h dp)                 (+ (point-v dp) (round (point-v s) 2)))))(defun middle-right (self)  (let ((dp (view-position self)) (s (view-size self)))    (make-point (+ (point-h dp) (point-h s))                (+ (point-v dp) (round (point-v s) 2))))) (defun middle-top (self)  (let ((dp (view-position self)) (s (view-size self)))    (make-point (+ (point-h dp) (round (point-h s) 2))                 (point-v dp))))(defun middle-bottom (self)  (let ((dp (view-position self)) (s (view-size self)))    (make-point (+ (point-h dp) (round (point-h s) 2))                (+ (point-v dp) (point-v s))))) (defun bottom-left (self)  (let ((dp (view-position self)) (s (view-size self)))    (make-point (point-h dp) (+ 