and Ys (lists of values).ex:(intextrapo .5 bpf)(intextrapo '(-1 0 2 5 12) bpf)(intextrapo 30 '(0 2 4 6 8 10 12 14 20) '(0 8 4 6 8 10 12 14 25))"  (intextrapo x xs ys))(om::defmethod! list2vector ((list list))  :icon 128  :doc "convert list into vector. must be rewrtitten into recursive form"  (coerce list 'vector))(om::defmethod! vector2list ((list list))  :icon 128  :doc "convert vector into list. must be rewrtitten into recursive form"  (coerce vector 'list))(om::defmethod! nnfind ()  :icon 128  (let* ((anns (search-ann))         (selected          (select-item-from-list anns                                 :default-button-text "select"                                 :selection-type :disjoint                                 :window-title "list of ANNs"                                 :view-size (make-point                                             200                                             (min 600 (+ 50 (* 14 (length anns)))))                                 )))    (loop for s in selected          do          (let ((opened? (find-window (string s) 'main-ann-window)))            (if opened?              (window-select opened?)              (make-instance 'main-ann-window                :ann (eval s)))))))(om::defmethod! mlp* ((name symbol) (ninput integer) (noutput integer) (nhidden1 integer) &rest nhidden)  :icon 130  (setf nhidden (append (list nhidden1) nhidden))  (eval `(mlp ,name ,ninput ,noutput .,nhidden))  (eval name))(om::defmethod! rcmlp* ((name symbol) (ninput integer) (noutput integer) (context-layer integer) (nhidden1 integer) &rest nhidden)  :initvals '(nil 4 4 0 4)  :icon 131  :doc "Recurrent multi-layer paerceptron, as described by Jordan and Elman."  (let (input+context)    (setf nhidden (append (list nhidden1) nhidden)          input+context (+ ninput (nth context-layer nhidden)))    (eval `(mlpj ,name ,input+context ,noutput .,nhidden))    (setf name (eval name)          (recurrent-layer name) context-layer          (recurrent-layer-activation name) (coerce (make-list (nth context-layer nhidden)                                                               :initial-element 0)                                                    'vector)          (in-size  name) ninput)    name))(om::defmethod! lvq* ((name symbol) (ncells integer))  :icon 130  (eval `(make-aam ,name ,ncells))  (eval name))(om::defmethod! train-mlp ((ann mlp) (input list) (target list)                           (learn-fact float) (error float) (bias float) (slope float)                           method verbose                           &optional                           (temp 0.0001)                           (input-fun nil)                           (hidden-fun #'logistic)                           (output-fun #'logistic))  :menuins ((7 (("random" 'random)                ("sequence"  'sequence)                ("minover"  'minover)))            (8 (("verbose" t)                ("quiet"  nil)                ))            )  :initvals '(nil nil nil 0.6 0.05 0.5 1.0 'random t (temp .005) nil #'logistic #'logistic)  :icon 128  :indoc '("mlp name" "input" "target" "learn factor" "error" "bias" "slope" "learning method"           "temperature" "input cell transfert function" "hidden cells transfert function" "output cells function")  :doc ""  (learn ann input target         :method method         :temp temp         :learn learn-fact         :slope slope         :input-func (eval input-fun)         :hidden-func (eval hidden-fun)         :out-func (eval output-fun)         :thresh bias         :error error         :verbose verbose))(om::defmethod! open-nn ((ann mlp))  :initvals '(nil nil nil 0.6 0.05 0.5 1.0 'random t)  :icon 129  :indoc '("mlp name")  :doc "Opens window for editing network of ann."  (make-instance 'main-ann-window :ann (eval ann))  )(om::defmethod! net-view ((ann mlp))  :initvals '(nil nil nil 0.6 0.05 0.5 1.0 'random t)  :icon 129  :indoc '("mlp name")  :doc "Opens window for editing network of ann."  (make-instance 'net-window :ann ann)  )(om::defmethod! train-rcmlp ((ann mlpj) (input list) (target list)                             (learn-fact float) (error float) (bias float) (slope float)                             (verbose t)                             &optional                             (temp 0.0)                             (input-fun nil)                             (hidden-fun #'logistic)                             (output-fun #'logistic))              :initvals '(nil nil nil 0.6 0.1 0.5 1.0 t nil #'logistic #'logistic)  :icon 128  :indoc '("mlp name" "input" "target" "learn factor" "error" "bias" "slope" "verbose"           "temperature" "input cell transfert function" "hidden cell transfert function" "output cell function")  :doc ""  (learn ann input target         :temp temp         :learn learn-fact         :slope slope         :input-func (eval input-fun)         :hidden-func (eval hidden-fun)         :out-func (eval output-fun)         :thresh bias         :error error         :verbose verbose))(om::defmethod! train-rcmlp ((ann mlpj) (input list) (target null)                             (learn-fact float) (error float) (bias float) (slope float)                             (verbose t)                             &optional                             (temp 0.0)                             (input-fun nil)                             (hidden-fun #'logistic)                             (output-fun #'logistic))              :initvals '(nil nil nil 0.6 0.1 0.5 1.0 t nil #'logistic #'logistic)  :icon 128  :indoc '("mlp name" "input" "target" "learn factor" "error" "bias" "slope" "verbose"           "temperature" "input cell transfert function" "hidden cell transfert function" "output cell function")  :doc ""  (declare (ignore target))  (learn ann (butlast input) (cdr input)         :temp temp         :learn learn-fact         :slope slope         :input-func (eval input-fun)         :hidden-func (eval hidden-fun)         :out-func (eval output-fun)         :thresh bias         :error error         :verbose verbose))(om::defmethod! train-aam ((ann aam) (input list) (learn-fact float))              :initvals '(nil nil .5)  :icon 128  ;:indoc '("mlp name" "input" "learn factor")  :doc ""  (train-saam input ann learn-fact)  )(om::defmethod! run-nn ((ann mlp) (input vector) (bias float) (slope float)                        &optional (temp 0.0) (output-fun #'logistic) (hidden-fun #'logistic))  :initvals '(nil nil .5 1.0 0.0 #'logistic #'logistic)  :icon 128  ;:indoc '("mlp name" "input" "bias" "slope" "temperature" "output function" "hidden-function")  :doc ""  (when (< temp .005) (setf temp .005))  (run-mlp ann input           :slope slope           :thresh bias           :temp temp           :out-func (eval output-fun)           :hidden-func (eval hidden-fun))  )(om::defmethod! run-nn ((ann symbol) (input vector) (bias float) (slope float)                        &optional (temp 0.0) (output-fun #'logistic) (hidden-fun #'logistic))  :initvals '(nil nil .5 1.0 0.0 #'logistic #'logistic)  :icon 128  ;:indoc '("mlp name" "input" "bias" "slope" "temperature" "output function" "hidden-function")  :doc ""  (when (< temp .005) (setf temp .005))  (setf ann (eval ann))  (run-mlp ann input           :slope slope           :thresh bias           :temp temp           :out-func (eval output-fun)           :hidden-func (eval hidden-fun))  )(om::defmethod! run-nn ((ann mlp) (input list) (bias float) (slope float)                        &optional (temp 0.0) (output-fun #'logistic) (hidden-fun #'logistic))  :initvals '(nil nil .5 1.0 0.0 #'logistic #'logistic)  :icon 128  ;:indoc '("mlp name" "input" "bias" "slope" "temperature" "output function" "hidden-function")  :doc ""  (when (< temp .005) (setf temp .005))  (setf ann (eval ann))  (run-mlp ann input           :slope slope           :thresh bias           :temp temp           :out-func (eval output-fun)           :hidden-func (eval hidden-fun))  )#|(om::defmethod! copy-nn ((ann mlp))              :initvals '(nil nil .5)  :icon 128  ;:indoc '("ann to copy")  :doc ""  (copy-net ann)  )(om::defmethod! copy-nn ((ann mlpj))              :initvals '(nil nil .5)  :icon 128  ;:indoc '("ann to copy")  :doc ""  (copy-net ann)  )|#(om::defmethod! export-nn ((ann ann))              :initvals '(nil nil .5)  :icon 128  ;:indoc '("ann to copy")  :doc ""  (save ann)  )(om::defmethod! load-nn ()              :initvals '(nil nil .5)  :icon 128  ;:indoc '("ann to copy")  :doc ""  (load-ann ann)  )